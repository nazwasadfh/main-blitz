C=$'\e[36m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; B=$'\e[1m'; N=$'\e[0m'
msg()  { printf '%s==>%s %s%s%s\n' "$G" "$N" "$B" "$*" "$N"; }
info() { printf '%s  ->%s %s\n' "$C" "$N" "$*"; }
warn() { printf '%s==> WARNING:%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%s==> ERROR:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    cat <<EOF
Usage: ./build-iso [options]

  -q, --query            show what buildiso would do, build nothing
  -n, --no-offline-repo  do not cache packages in the ISO (installer downloads everything)
  -y, --yes              answer yes to prompts (move aside a foreign iso-profiles dir, ...)
  --latest               ignore the commit/tag pins of third-party sources (use their newest versions)
  -h, --help             this help

Environment:
  BLITZART_DOTS_URL      dots repository   (default: $DOTS_URL)
  BLITZART_DOTS_REF      pin the dots to this full commit sha (default: branch head)
  WORKSPACE_DIR          artools workspace (default: ~/artools-workspace)
EOF
}

QUERY=0; OFFLINE=1; YES=0; LATEST=0
for a in "$@"; do
    case $a in
        -q|--query) QUERY=1 ;;
        -n|--no-offline-repo) OFFLINE=0 ;;
        -y|--yes) YES=1 ;;
        --latest) LATEST=1 ;;
        -h|--help) usage; exit 0 ;;
        *) usage; die "unknown option: $a" ;;
    esac
done

# ------------------------------------------------------------------ privileges
if [[ $EUID -ne 0 ]]; then
    have sudo || die "run as root or install sudo"
    exec sudo -E "$0" "$@"
fi
REAL_USER=${SUDO_USER:-root}
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
WORKSPACE=${WORKSPACE_DIR:-$REAL_HOME/artools-workspace}
CONF_DIR=${XDG_CONFIG_HOME:-$REAL_HOME/.config}/artools
[[ $REAL_USER != root ]] && CONF_DIR=$REAL_HOME/.config/artools

ask() { ((YES)) && return 0; local a; read -r -p "$1 [y/N] " a || return 1; [[ $a =~ ^[Yy] ]]; }

# ------------------------------------------------------------------ dependencies
check_deps() {
    msg "Checking build dependencies"
    have pacman || die "this builder needs an Artix (or Arch based) host with pacman"
    local missing=()
    have buildiso || missing+=(artools-iso)
    have git      || missing+=(git)
    have curl     || missing+=(curl)
    have tar      || missing+=(tar)
    have repo-add || missing+=(pacman)
    pacman -Qq artix-archlinux-support >/dev/null 2>&1 || missing+=(artix-archlinux-support)
    pacman -Qq archlinux-keyring >/dev/null 2>&1       || missing+=(archlinux-keyring)
    if ((${#missing[@]})); then
        info "missing: ${missing[*]}"
        ask "Install them with pacman now?" || die "install the missing packages and run again"
        pacman -S --needed --noconfirm "${missing[@]}" || die "pacman failed"
    fi
    # the build chroot verifies Arch packages with the HOST keyring
    # (no `| grep -q`: under pipefail the writer gets SIGPIPE and the pipeline is reported as failed)
    if ! grep -qi 'archlinux.org' < <(gpg --homedir /etc/pacman.d/gnupg --list-keys 2>/dev/null); then
        info "populating the Arch Linux keyring on the host"
        pacman-key --init >/dev/null 2>&1 || true
        pacman-key --populate archlinux || warn "pacman-key --populate archlinux failed"
    fi
    modprobe loop 2>/dev/null || true
    [[ -f /etc/pacman.d/mirrorlist-arch ]] || die "/etc/pacman.d/mirrorlist-arch missing (artix-archlinux-support)"
}

# ------------------------------------------------------------------ payload / sources
extract_payload() {
    STAGE=$(mktemp -d /tmp/blitzart-stage.XXXXXX)
    trap 'rm -rf "$STAGE"' EXIT
    awk '/^__PAYLOAD__$/{f=1;next} f' "$0" | base64 -d | tar -xz -C "$STAGE" \
        || die "cannot unpack the embedded payload (is this file truncated?)"
    [[ -d $STAGE/profile/$PROFILE ]] || die "payload is missing the profile"
}

pin() { ((LATEST)) && echo "" || echo "$1"; }

sync_repo() { # url dir label [full-sha]
    local url=$1 dir=$2 label=$3 ref=${4:-}
    if [[ -n $ref ]]; then
        [[ $ref =~ ^[0-9a-f]{40}$ ]] || die "invalid pin for $label: '$ref' (a full 40-character sha is required)"
        if [[ -d $dir/.git ]] && [[ $(git -C "$dir" remote get-url origin 2>/dev/null) == "$url" ]] \
           && [[ $(git -C "$dir" rev-parse HEAD 2>/dev/null) == "$ref" ]]; then
            info "$label pinned at ${ref:0:8} (cached)"; return 0
        fi
        rm -rf "$dir"; mkdir -p "$dir"
        git -C "$dir" init -q && git -C "$dir" remote add origin "$url" \
            && git -C "$dir" fetch -q --depth 1 origin "$ref" \
            && git -C "$dir" -c advice.detachedHead=false checkout -q --detach FETCH_HEAD \
            || die "cannot fetch $label at ${ref:0:8} from $url"
        [[ $(git -C "$dir" rev-parse HEAD) == "$ref" ]] || die "$label: the fetched commit does not match the pin"
        info "$label pinned at ${ref:0:8}"
        return 0
    fi
    if [[ -d $dir/.git ]] && [[ $(git -C "$dir" remote get-url origin 2>/dev/null) == "$url" ]]; then
        info "updating $label ($dir)"
        git -C "$dir" fetch --depth 1 origin HEAD -q && git -C "$dir" reset --hard FETCH_HEAD -q \
            && git -C "$dir" clean -fdxq || { warn "update failed, recloning"; rm -rf "$dir"; }
    elif [[ -e $dir ]]; then
        rm -rf "$dir"
    fi
    if [[ ! -d $dir/.git ]]; then
        info "cloning $label"
        git clone --depth 1 -q "$url" "$dir" || die "cannot clone $url"
    fi
    info "$label at $(git -C "$dir" rev-parse --short HEAD) (NOT pinned)"
}

# ------------------------------------------------------------------ pacman configs
# $1 = file, $2 = SigLevel for the Artix/Arch repos
write_pacman_conf() {
    cat >"$1" <<EOF
$MARK - generated by build-iso
[options]
HoldPkg      = pacman glibc
Architecture = auto
Color
ILoveCandy
CheckSpace
VerbosePkgLists
ParallelDownloads = 5
SigLevel = $2
LocalFileSigLevel = Optional

[system]
Include = /etc/pacman.d/mirrorlist

[world]
Include = /etc/pacman.d/mirrorlist

[galaxy]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist-arch

[multilib]
Include = /etc/pacman.d/mirrorlist-arch
EOF
}

install_artools_conf() {
    msg "Configuring artools pacman repositories (artix + arch)"
    local sysdir="" d f targets=() dst
    # artools >= 0.2x: per-repo configs in pacman.conf.d/ (e.g. iso-x86_64.conf);
    # older artools: a single pacman-default.conf. Override both so the right one wins.
    for d in /usr/share/artools/pacman.conf.d /usr/share/artools/pacmanconf.d; do
        [[ -d $d ]] && { sysdir=$d; break; }
    done
    if [[ -n $sysdir ]]; then
        for f in "$sysdir"/iso-*.conf; do [[ -e $f ]] && targets+=("$(basename "$f")"); done
    fi
    ((${#targets[@]})) || targets=("iso-$(uname -m).conf")
    info "artools configs: ${targets[*]} (system dir: ${sysdir:-not found})"

    mkdir -p "$CONF_DIR/pacman.conf.d"
    for f in "${targets[@]}"; do
        dst=$CONF_DIR/pacman.conf.d/$f
        if [[ -f $dst ]] && ! grep -q "^$MARK" "$dst"; then cp -n "$dst" "$dst.bak-blitzart" && info "backed up your $dst"; fi
        write_pacman_conf "$dst" "Required DatabaseOptional"
    done
    dst=$CONF_DIR/pacman-default.conf
    if [[ -f $dst ]] && ! grep -q "^$MARK" "$dst"; then cp -n "$dst" "$dst.bak-blitzart" && info "backed up your $dst"; fi
    write_pacman_conf "$dst" "Required DatabaseOptional"
    chown -R "$REAL_USER":"$(id -gn "$REAL_USER")" "$CONF_DIR" 2>/dev/null || true
}

# Sync a throw-away db with the same repos the ISO build uses and make sure every
# package named in the profile exists - fails here in seconds instead of mid-build.
sync_dl_db() {
    mkdir -p "$STATE_DIR/pkgs" "$STATE_DIR/db/local"
    write_pacman_conf "$STATE_DIR/pacman-dl.conf" "Required DatabaseOptional"
    pacman --config "$STATE_DIR/pacman-dl.conf" --dbpath "$STATE_DIR/db" --logfile /dev/null --noconfirm -Sy >/dev/null \
        || die "cannot sync package databases (mirrors / network?)"
}

profile_package_names() {
    local f
    for f in "$STAGE/profile/common/common.yaml" "$STAGE/profile/$PROFILE/profile.yaml"; do
        awk '
            /^[[:space:]]*#/ {next}
            /^[[:space:]]*packages[a-z-]*:/ {on=1; next}
            /^[[:space:]]*(dinit|openrc|runit|s6):/ {next}
            /^[[:space:]]*[A-Za-z-]+:/ {on=0; next}
            on && /^[[:space:]]*-[[:space:]]/ { sub(/^[[:space:]]*-[[:space:]]*/,""); sub(/[[:space:]]*#.*/,""); print }
        ' "$f"
    done | sort -u
}

check_package_names() {
    local names out rc=0 missing
    msg "Verifying that every package in the profile exists in the configured repos"
    sync_dl_db
    # shellcheck disable=SC1091
    mapfile -t names < <({ profile_package_names
        ( . "$STAGE/profile/$PROFILE/live-overlay/usr/lib/blitzart/packages.sh"; ba_all_offline_pkgs; printf '%s\n' "${BA_GUI_NET_PKGS[@]}" )
    } | sort -u)
    ((${#names[@]})) || die "could not read any package names from the profile"
    out=$(pacman --config "$STATE_DIR/pacman-dl.conf" --dbpath "$STATE_DIR/db" --logfile /dev/null --noconfirm \
          -Sp "${names[@]}" 2>&1 >/dev/null) || rc=$?
    # NOTE: grep exits 1 when nothing matches - must not abort under set -e/pipefail
    missing=$(grep -i 'target not found' <<<"$out" | sed 's/.*: //' | tr '\n' ' ') || true
    if [[ -n $missing ]]; then
        die "packages not found in artix/arch repos: $missing- fix profile.yaml / common.yaml"
    fi
    if ((rc != 0)); then
        warn "pacman could not fully resolve the package set (exit $rc):"
        printf '%s\n' "$out" | tail -n 15 >&2
        warn "continuing - the real build will show whether this matters"
    fi
    info "${#names[@]} package names OK"
}

# ------------------------------------------------------------------ offline repo
# Download <pkg>... (+ dependencies) with <conf>/<db>, verify signatures, copy packages + .sig to <dest>.
cache_packages() { # conf db dest pkg...
    local conf=$1 db=$2 dest=$3 urls f
    shift 3
    mapfile -t urls < <(pacman --config "$conf" --dbpath "$db" --logfile /dev/null --noconfirm -Sp "$@" 2>/dev/null | grep -E '^(https?|file)://')
    ((${#urls[@]})) || return 1
    pacman --config "$conf" --dbpath "$db" --cachedir "$STATE_DIR/pkgs" --logfile /dev/null \
        --noconfirm -Sw "$@" || return 1
    mkdir -p "$dest"
    for f in "${urls[@]}"; do
        f=$(basename "$f")
        [[ -f $STATE_DIR/pkgs/$f ]]     || { warn "expected $f in the cache"; return 1; }
        [[ -f $STATE_DIR/pkgs/$f.sig ]] || { warn "missing signature for $f (refusing to build an unsigned repo)"; return 1; }
        cp -al --reflink=auto "$STATE_DIR/pkgs/$f" "$dest/$f" 2>/dev/null || cp "$STATE_DIR/pkgs/$f" "$dest/$f"
        cp -al --reflink=auto "$STATE_DIR/pkgs/$f.sig" "$dest/$f.sig" 2>/dev/null || cp "$STATE_DIR/pkgs/$f.sig" "$dest/$f.sig"
    done
}

# chaotic-aur for the BUILD only: an isolated keyring (artix + arch + chaotic), the host keyring is not touched
setup_chaotic_dl() {
    # trust the key again every $CHAOTIC_MAX_AGE_DAYS days (keys get rotated/revoked), not forever
    # (the marker also carries the setup version: an older/incomplete keyring setup is never reused)
    [[ $(cat "$STATE_DIR/chaotic.ok" 2>/dev/null) == "$CHAOTIC_SETUP_VER" ]] \
        && [[ -n $(find "$STATE_DIR/chaotic.ok" -mtime "-$CHAOTIC_MAX_AGE_DAYS" 2>/dev/null) ]] && return 0
    rm -rf "$CHAOTIC_GPG"; mkdir -p "$CHAOTIC_GPG"; chmod 700 "$CHAOTIC_GPG"
    pacman-key --gpgdir "$CHAOTIC_GPG" --init >/dev/null 2>&1 || return 1
    pacman-key --gpgdir "$CHAOTIC_GPG" --populate artix archlinux >/dev/null 2>&1 || return 1
    pacman-key --gpgdir "$CHAOTIC_GPG" --keyserver keyserver.ubuntu.com --recv-keys "$CHAOTIC_KEY" >/dev/null 2>&1 || return 1
    pacman-key --gpgdir "$CHAOTIC_GPG" --lsign-key "$CHAOTIC_KEY" >/dev/null 2>&1 || return 1
    chaotic_load_keyring || return 1
    printf %s "$CHAOTIC_SETUP_VER" >"$STATE_DIR/chaotic.ok"
}

# Chaotic's packages are signed by Garuda's PACKAGER keys (e.g. "TNE"), not by the master key above - trusting only
# the master key gives "signature ... is unknown trust". Those keys ship in the chaotic-keyring package, which is
# itself signed by the master key: verify that signature first, then load the keyring into the isolated gpgdir.
chaotic_load_keyring() {
    local d rc
    d=$(mktemp -d)
    _chaotic_load_keyring_in "$d"; rc=$?
    rm -rf "$d"
    return $rc
}

_chaotic_load_keyring_in() { # $1 = scratch dir
    local d=$1 base=https://cdn-mirror.chaotic.cx/chaotic-aur status fpr kr
    curl -fsSL -m 120 -o "$d/k.pkg" "$base/chaotic-keyring.pkg.tar.zst" \
        && curl -fsSL -m 60 -o "$d/k.pkg.sig" "$base/chaotic-keyring.pkg.tar.zst.sig" \
        || { warn "chaotic: cannot download chaotic-keyring"; return 1; }
    status=$(gpg --homedir "$CHAOTIC_GPG" --status-fd 1 --verify "$d/k.pkg.sig" "$d/k.pkg" 2>/dev/null || true)
    fpr=$(awk '$2 == "VALIDSIG" { print $NF }' <<<"$status")
    [[ -n $fpr && $fpr == *"$CHAOTIC_KEY" ]] \
        || { warn "chaotic: chaotic-keyring is not signed by the expected key (got: ${fpr:-none})"; return 1; }
    mkdir -p "$d/x" && bsdtar -xf "$d/k.pkg" -C "$d/x" usr/share/pacman/keyrings \
        || { warn "chaotic: cannot unpack chaotic-keyring"; return 1; }
    kr=$d/x/usr/share/pacman/keyrings
    if ! pacman-key --gpgdir "$CHAOTIC_GPG" --populate-from "$kr" chaotic >/dev/null 2>&1; then
        # older pacman-key without --populate-from: import the keys and their ownertrust by hand
        gpg --homedir "$CHAOTIC_GPG" --batch --import "$kr/chaotic.gpg" >/dev/null 2>&1 \
            || { warn "chaotic: cannot import chaotic.gpg"; return 1; }
        [[ ! -f $kr/chaotic-trusted ]] || gpg --homedir "$CHAOTIC_GPG" --batch --import-ownertrust "$kr/chaotic-trusted" >/dev/null 2>&1
    fi
    # the master keys listed in chaotic-trusted (the packages are signed by one of them, TNE) must also be signed
    # locally - that is the last step of a real `pacman-key --populate`; without it the key stays "unknown trust".
    local fpr v bad=0
    while IFS=: read -r fpr _; do
        [[ $fpr =~ ^[0-9A-Fa-f]{40}$ ]] || continue
        pacman-key --gpgdir "$CHAOTIC_GPG" --lsign-key "$fpr" >/dev/null 2>&1 || true
        v=$(gpg --homedir "$CHAOTIC_GPG" --with-colons --list-keys "$fpr" 2>/dev/null | awk -F: '/^pub/ { print $2; exit }')
        [[ $v == f || $v == u ]] || { warn "chaotic: key ${fpr: -16} is not trusted after setup (validity '${v:-none}')"; bad=1; }
    done <"$kr/chaotic-trusted"
    return $bad
}

write_chaotic_conf() { # file
    write_pacman_conf "$1" "Required DatabaseOptional"
    sed -i "0,/^\[options\]/s||[options]\nGPGDir = $CHAOTIC_GPG|" "$1"
    cat >>"$1" <<EOF

[chaotic-aur]
Server = https://cdn-mirror.chaotic.cx/\$repo/\$arch
EOF
}

sync_chaotic_db() {
    mkdir -p "$STATE_DIR/db-chaotic/local"
    write_chaotic_conf "$STATE_DIR/pacman-chaotic.conf"
    pacman --config "$STATE_DIR/pacman-chaotic.conf" --dbpath "$STATE_DIR/db-chaotic" --logfile /dev/null \
        --noconfirm -Sy >/dev/null 2>&1
}

build_offline_repo() { # $1 = destination dir
    local dest=$1 pkgs
    # shellcheck disable=SC1091
    . "$STAGE/profile/$PROFILE/live-overlay/usr/lib/blitzart/packages.sh"
    mapfile -t pkgs < <(ba_all_offline_pkgs | sort -u)
    msg "Caching ${#pkgs[@]} packages (+ dependencies) for the offline repo"

    # signatures are downloaded and verified against the host keyring (artix + archlinux);
    # the .sig files are shipped next to the packages so the installer verifies them again
    sync_dl_db
    cache_packages "$STATE_DIR/pacman-dl.conf" "$STATE_DIR/db" "$dest" "${pkgs[@]}" || die "package download failed"

    # prebuilt AUR dependencies of illogical-impulse from chaotic-aur (best effort)
    if ((${#BA_II_CHAOTIC_PKGS[@]})); then
        msg "Caching ${#BA_II_CHAOTIC_PKGS[@]} prebuilt AUR packages from chaotic-aur"
        if setup_chaotic_dl && sync_chaotic_db; then
            cache_packages "$STATE_DIR/pacman-chaotic.conf" "$STATE_DIR/db-chaotic" "$dest" "${BA_II_CHAOTIC_PKGS[@]}" \
                || warn "chaotic-aur caching failed - those packages are fetched at install time instead"
        else
            warn "could not set up chaotic-aur for the build - those packages are fetched at install time instead"
        fi
    fi

    find "$dest" -maxdepth 1 -name '*.pkg.tar.*' ! -name '*.sig' -print0 \
        | xargs -0 repo-add -q "$dest/blitzart-local.db.tar.zst" >/dev/null
    info "offline repo: $(find "$dest" -maxdepth 1 -name '*.pkg.tar.*' ! -name '*.sig' | wc -l) signed packages, $(du -sh "$dest" | cut -f1)"
}

# illogical-impulse (end-4/dots-hyprland): the Arch dependency lists are the `depends`/`makedepends` of the
# meta-PKGBUILDs in sdata/dist-arch. Split them into: Artix/Arch repos (cached in the ISO), chaotic-aur
# prebuilt AUR packages (cached in the ISO) and the rest (AUR/sources: fetched at install time by ii itself).
# PKGBUILDs come from a third-party repo and build-iso runs as root: they are only READ here, never sourced.
read_ii_depends() {
    local f prog
    prog=$(mktemp)
    cat >"$prog" <<'AWK'
# Prints the names listed in depends=(...) / makedepends=(...) of a PKGBUILD WITHOUT executing anything.
# An array that contains a command substitution ($( ) or backticks) is dropped as a whole, with a warning:
# its contents cannot be known statically, and a partial list would be worse than none.
function emit(tok) {
    gsub(/^["\x27]|["\x27]$/, "", tok)
    if (tok ~ /^[A-Za-z0-9@._+-]+([<>=][^ ]*)?$/) buf = buf tok "\n"
    else if (tok != "") bad++
}
{
    line = $0; sub(/#.*/, "", line)
    if (!inarr) {
        if (match(line, /^(depends|makedepends)\+?=\(/)) { inarr = 1; dyn = 0; buf = ""; bad = 0; line = substr(line, RLENGTH + 1) }
        else next
    }
    if (line ~ /\$\(|`/) dyn = 1
    if (!dyn && (idx = index(line, ")")) > 0) { line = substr(line, 1, idx - 1); done = 1 }
    if (!dyn) { n = split(line, t, /[ \t]+/); for (i = 1; i <= n; i++) if (t[i] != "") emit(t[i]) }
    if (!dyn && done) { printf "%s", buf; if (bad) skipped += bad; inarr = 0; done = 0 }
    else if (dyn && line ~ /\)[ \t]*$/) { dropped++; inarr = 0; done = 0 }
}
END {
    if (skipped) printf "build-iso: skipped %d non-literal dependency entries in %s\n", skipped, FILENAME > "/dev/stderr"
    if (dropped) printf "build-iso: dropped %d dependency array(s) with command substitution in %s\n", dropped, FILENAME > "/dev/stderr"
}
AWK
    for f in "$II_DIR"/sdata/dist-arch/illogical-impulse-*/PKGBUILD; do
        awk -f "$prog" "$f"
    done | grep -v '^$' || true
    rm -f "$prog"
}

prepare_ii_packages() {
    local out=$STAGE/profile/$PROFILE/live-overlay/usr/lib/blitzart/ii-packages.sh
    local all=() off=() missing=() chao=() net=() res miss p
    msg "Reading the illogical-impulse dependency lists"
    mapfile -t all < <({ read_ii_depends; printf '%s\n' "${II_EXTRA_PKGS[@]}"; } | sed -E 's/[<>=].*//' | sort -u)
    ((${#all[@]} > 10)) || die "could not read the illogical-impulse dependency lists (repo layout changed?)"

    sync_dl_db
    res=$(pacman --config "$STATE_DIR/pacman-dl.conf" --dbpath "$STATE_DIR/db" --logfile /dev/null --noconfirm \
          -Sp "${all[@]}" 2>&1 >/dev/null) || true
    miss=$(grep -i 'target not found' <<<"$res" | sed 's/.*: //') || true
    for p in "${all[@]}"; do
        if grep -qxF "$p" <<<"$miss"; then missing+=("$p"); else off+=("$p"); fi
    done

    if ((OFFLINE && ${#missing[@]})) && setup_chaotic_dl && sync_chaotic_db; then
        res=$(pacman --config "$STATE_DIR/pacman-chaotic.conf" --dbpath "$STATE_DIR/db-chaotic" --logfile /dev/null \
              --noconfirm -Sp "${missing[@]}" 2>&1 >/dev/null) || true
        miss=$(grep -i 'target not found' <<<"$res" | sed 's/.*: //') || true
        for p in "${missing[@]}"; do
            if grep -qxF "$p" <<<"$miss"; then net+=("$p"); else chao+=("$p"); fi
        done
    else
        net=("${missing[@]}")
    fi

    {
        echo "# generated by build-iso from end-4/dots-hyprland $(git -C "$II_DIR" rev-parse --short HEAD)"
        echo "BA_II_PKGS=("; for p in "${off[@]}"; do echo "    $p"; done; echo ")"
        echo "BA_II_CHAOTIC_PKGS=("; for p in "${chao[@]}"; do echo "    $p"; done; echo ")"
        echo "BA_II_NET_PKGS=("; for p in "${net[@]}"; do echo "    $p"; done; echo ")"
    } >"$out"
    info "illogical-impulse: ${#off[@]} packages from the repos, ${#chao[@]} prebuilt from chaotic-aur, ${#net[@]} from AUR/sources at install time"
    ((${#net[@]})) && info "install-time (AUR/source): ${net[*]}"
    return 0
}

# sddm-slice has Qt6 imports (Qt5Compat.GraphicalEffects) but its metadata.desktop has no QtVersion,
# so SDDM starts the Qt5 greeter and fails with "Library import requires a version".
patch_sddm_theme() {
    local md=$1/metadata.desktop
    [[ -f $md ]] || { warn "sddm-slice has no metadata.desktop"; return 0; }
    if grep -q '^QtVersion=' "$md"; then sed -i 's/^QtVersion=.*/QtVersion=6/' "$md"
    else sed -i -e '$a\' "$md"; echo 'QtVersion=6' >>"$md"; fi
    # Qt6 resolves this module without a version
    sed -i 's/^import QtQuick\.VirtualKeyboard [0-9.]*$/import QtQuick.VirtualKeyboard/' "$1"/Main.qml "$1"/slice/*.qml 2>/dev/null || true
    info "sddm-slice patched for the Qt6 greeter (QtVersion=6)"
}

# Bibata-Modern-Classic cursor (AUR-only, so it is bundled from the upstream release like the dots)
# Fonts named in the dots' illogical-impulse config.json that no Arch/Chaotic package provides in a stable way
# (the AUR packages download from URLs that move): taken from the Google Fonts repository at a pinned commit and
# checked against sha256. Both are OFL-licensed; the licence files are shipped with them.
fetch_google_fonts() { # $1 = destination dir inside the overlay
    local dst=$1 dir=$STATE_DIR/fonts ref=$PIN_GFONTS spec path name sha got
    mkdir -p "$dir" "$dst"
    if ((LATEST)); then
        ref=$(git ls-remote "https://github.com/google/fonts" HEAD | cut -f1)
        [[ $ref =~ ^[0-9a-f]{40}$ ]] || die "cannot resolve google/fonts HEAD"
        warn "Google fonts: --latest, downloads are NOT checked against checksums"
    fi
    for spec in \
        "ofl/patrickhand/PatrickHand-Regular.ttf|PatrickHand-Regular.ttf|$PIN_GF_PATRICK_SHA256" \
        "ofl/patrickhand/OFL.txt|OFL-PatrickHand.txt|$PIN_GF_PATRICK_OFL_SHA256" \
        "ofl/googlesansflex/GoogleSansFlex%5BROND,opsz,slnt,wdth,wght%5D.ttf|GoogleSansFlex-VF.ttf|$PIN_GF_GSFLEX_SHA256" \
        "ofl/googlesansflex/OFL.txt|OFL-GoogleSansFlex.txt|$PIN_GF_GSFLEX_OFL_SHA256"; do
        IFS='|' read -r path name sha <<<"$spec"
        if ! ((LATEST)) && [[ -f $dir/$ref-$name ]] && [[ $(sha256sum "$dir/$ref-$name" | cut -d' ' -f1) == "$sha" ]]; then
            info "font $name (cached, checksum ok)"
        else
            info "fetching font $name"
            curl -fsSL -m 240 -o "$dir/new.part" "https://raw.githubusercontent.com/google/fonts/$ref/$path" \
                && [[ -s $dir/new.part ]] || { rm -f "$dir/new.part"; die "cannot download font $name"; }
            got=$(sha256sum "$dir/new.part" | cut -d' ' -f1)
            if ! ((LATEST)) && [[ $got != "$sha" ]]; then rm -f "$dir/new.part"; die "font $name: sha256 mismatch (got $got, expected $sha)"; fi
            mv "$dir/new.part" "$dir/$ref-$name"
        fi
        install -Dm644 "$dir/$ref-$name" "$dst/$name"
    done
}

fetch_cursor_theme() { # $1 = destination dir inside the overlay
    local dir=$STATE_DIR/bibata tmp tag url file sum
    mkdir -p "$dir" "$1"
    if ((LATEST)); then
        tag=latest; url=$CURSOR_REPO/releases/latest/download/Bibata-Modern-Classic.tar.xz
        warn "Bibata cursor: --latest, the download is NOT checked against a checksum"
    else
        tag=$PIN_BIBATA_TAG; url=$CURSOR_REPO/releases/download/$tag/Bibata-Modern-Classic.tar.xz
    fi
    file=$dir/Bibata-Modern-Classic-$tag.tar.xz
    tmp=$dir/new.tar.xz; rm -f "$tmp"
    if ! ((LATEST)) && [[ -f $file ]] && [[ $(sha256sum "$file" | cut -d' ' -f1) == "$PIN_BIBATA_SHA256" ]]; then
        info "Bibata cursor $tag (cached, checksum ok)"
    else
        info "fetching the Bibata-Modern-Classic cursor theme ($tag)"
        if curl -fsSL -m 180 -o "$tmp" "$url" && [[ -s $tmp ]]; then
            mv "$tmp" "$file"
        elif [[ -f $file ]] && ((LATEST)); then
            info "cursor theme: using the cached copy"
        else
            die "cannot download $url"
        fi
        rm -f "$tmp"
        if ! ((LATEST)); then
            sum=$(sha256sum "$file" | cut -d' ' -f1)
            [[ $sum == "$PIN_BIBATA_SHA256" ]] || { rm -f "$file"; die "Bibata $tag: sha256 mismatch (got $sum, expected $PIN_BIBATA_SHA256)"; }
        fi
    fi
    grep -q '^Bibata-Modern-Classic/cursors/' < <(tar -tf "$file" 2>/dev/null) \
        || die "unexpected cursor archive layout"
    install -Dm644 "$file" "$1/Bibata-Modern-Classic.tar.xz"
}

# ------------------------------------------------------------------ profile staging
stage_profile() {
    local iso_profiles=$WORKSPACE/iso-profiles
    msg "Staging the profile in $iso_profiles"
    mkdir -p "$WORKSPACE"
    if [[ -e $iso_profiles && ! -e $iso_profiles/.blitzart ]]; then
        warn "$iso_profiles exists and is not managed by build-iso"
        ask "Move it to $iso_profiles.bak-$(date +%s) and continue?" || die "aborted"
        mv "$iso_profiles" "$iso_profiles.bak-$(date +%s)"
    fi
    rm -rf "$iso_profiles"
    mkdir -p "$iso_profiles"
    : >"$iso_profiles/.blitzart"
    cp -a "$STAGE/profile/common" "$iso_profiles/common"
    cp -a "$STAGE/profile/$PROFILE" "$iso_profiles/$PROFILE"

    local lo=$iso_profiles/$PROFILE/live-overlay
    # installer + toolbox
    install -Dm755 "$STAGE/data/blitz" "$lo/usr/local/bin/blitz"

    # dots (fastfetch, eza, hypr, kitty, starship.toml, .zshrc, config.json = illogical-impulse settings); hypr is only installed with the GUI option -> /usr/share/blitzart/dots
    local d=$lo/usr/share/blitzart/dots
    mkdir -p "$d"
    local item
    for item in fastfetch eza hypr kitty starship.toml .zshrc config.json; do
        if [[ -e $DOTS_DIR/$item ]]; then cp -a "$DOTS_DIR/$item" "$d/"; else warn "dots repo has no '$item'"; fi
    done
    # oh-my-zsh -> /usr/share/blitzart/oh-my-zsh (no .git)
    mkdir -p "$lo/usr/share/blitzart/oh-my-zsh"
    (cd "$OMZ_DIR" && tar --exclude=.git -cf - .) | tar -xf - -C "$lo/usr/share/blitzart/oh-my-zsh"

    # sddm-slice theme -> /usr/share/blitzart/sddm-theme/sddm-slice (no .git); used only by the GUI option
    mkdir -p "$lo/usr/share/blitzart/sddm-theme/sddm-slice"
    (cd "$SDDM_DIR" && tar --exclude=.git -cf - .) | tar -xf - -C "$lo/usr/share/blitzart/sddm-theme/sddm-slice"
    patch_sddm_theme "$lo/usr/share/blitzart/sddm-theme/sddm-slice"

    fetch_cursor_theme "$lo/usr/share/blitzart/cursors"
    fetch_google_fonts "$lo/usr/share/blitzart/fonts"

    # illogical-impulse + end4-pC, each packed as one archive (with .git so they can be updated later)
    info "packing dots-hyprland and end4-pC into the ISO"
    mkdir -p "$lo/usr/share/blitzart"
    tar -C "$II_DIR" -cJf "$lo/usr/share/blitzart/dots-hyprland.tar.xz" . || die "cannot pack dots-hyprland"
    tar -C "$E4_DIR" -cJf "$lo/usr/share/blitzart/end4-pC.tar.xz" . || die "cannot pack end4-pC"

    # live user's skel: same dots, so the tty session looks like the installed system
    local skel=$lo/etc/skel
    mkdir -p "$skel/.config"
    [[ -d $d/fastfetch ]]     && cp -a "$d/fastfetch" "$skel/.config/"
    [[ -d $d/eza ]]           && cp -a "$d/eza" "$skel/.config/"
    [[ -d $d/kitty ]]         && cp -a "$d/kitty" "$skel/.config/"
    [[ -f $d/starship.toml ]] && cp -a "$d/starship.toml" "$skel/.config/"
    [[ -f $d/.zshrc ]]        && cp -a "$d/.zshrc" "$skel/.zshrc"

    # artools copies overlays with symlinks dereferenced: a dangling link aborts the build
    local dangling
    dangling=$(find "$iso_profiles/$PROFILE" -xtype l 2>/dev/null) || true
    [[ -z $dangling ]] || die "dangling symlinks in the profile (cp would fail): $dangling"

    if ((OFFLINE && !QUERY)); then
        build_offline_repo "$lo/opt/blitzart/repo"
    fi
    chown -R "$REAL_USER":"$(id -gn "$REAL_USER")" "$WORKSPACE" 2>/dev/null || true
}

# ------------------------------------------------------------------ main
main() {
    check_deps
    extract_payload
    sync_repo "$DOTS_URL" "$DOTS_DIR" "dots" "${BLITZART_DOTS_REF:-}"
    sync_repo "$OMZ_URL" "$OMZ_DIR" "oh-my-zsh" "$(pin "$PIN_OMZ")"
    sync_repo "$SDDM_URL" "$SDDM_DIR" "sddm-slice theme" "$(pin "$PIN_SDDM")"
    sync_repo "$II_URL" "$II_DIR" "illogical-impulse (dots-hyprland)" "$(pin "$PIN_II")"
    git -C "$II_DIR" submodule update --init --recursive --depth 1 -q || warn "dots-hyprland submodules could not be fetched"
    sync_repo "$E4_URL" "$E4_DIR" "end4-pC" "$(pin "$PIN_E4")"
    install_artools_conf
    prepare_ii_packages
    check_package_names
    stage_profile

    if ((QUERY)); then
        msg "Query mode: buildiso -p $PROFILE -i $INIT -q"
        buildiso -p "$PROFILE" -i "$INIT" -q || true
        return 0
    fi
    msg "Building BlitzArt ISO (buildiso -p $PROFILE -i $INIT)"
    buildiso -p "$PROFILE" -i "$INIT"

    local iso
    iso=$(find "$WORKSPACE/iso" /var/lib/artools/iso "$REAL_HOME/artools-workspace/iso" -name '*.iso' -newer "$STAGE" 2>/dev/null | sort | tail -n1 || true)
    if [[ -n $iso ]]; then msg "Done: $iso"; else msg "Build finished - look for the ISO under $WORKSPACE/iso or /var/lib/artools/iso"; fi
}

main "$@"
exit 0
