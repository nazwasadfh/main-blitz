readonly II_DIR="/tmp/blitzart-dots-hyprland"
readonly E4_URL="https://github.com/pctrade/end4-pC"
readonly E4_DIR="/tmp/blitzart-end4-pc"
readonly CHAOTIC_KEY="3056513887B78AEB"
readonly CHAOTIC_GPG="/var/cache/blitzart-build/gnupg-chaotic"
