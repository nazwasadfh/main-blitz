#  blitz mirrors
# ======================================================================
usage_mirrors() { cat <<'EOF'
Usage: blitz mirrors [options]
  -n, --number N       Artix mirrors to keep after ranking (default 10)
  -c, --country CODE   country filter for the Arch mirrors (reflector), e.g. PL,DE
  -s, --show           show the active mirrors
  -r, --restore        restore the previous mirror lists (*.bak)
  -h, --help           show this help
EOF
}

cmd_mirrors() {
    local count=10 country="" show=0 restore=0 f
    while (( $# )); do
        case $1 in
            -n|--number)  need_arg "$@"; count=$2; shift ;;
            -c|--country) need_arg "$@"; country=$2; shift ;;
            -s|--show)    show=1 ;;
            -r|--restore) restore=1 ;;
            -h|--help)    usage_mirrors; return 0 ;;
            *) die "Unknown option: $1" ;;
        esac
        shift
    done
    [[ $count =~ ^[0-9]+$ ]] || die "--number needs a number."
    if (( show )); then
        for f in /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist-arch; do
            [[ -f $f ]] || continue
            msg "$f"; grep -E '^Server' "$f" | sed 's/^/   /'
        done
        return 0
    fi
    need_root; start_log
    if (( restore )); then
        for f in /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist-arch; do
            [[ -f $f.bak ]] && cp -f "$f.bak" "$f" && ok "Restored $f"
        done
        return 0
    fi
    do_mirrors "$country" "$count"
}

# ======================================================================
#  blitz pacnew
# ======================================================================
usage_pacnew() { cat <<'EOF'
Usage: blitz pacnew [options]
  (no options)   list .pacnew / .pacsave files
  -d, --diff     show a diff for every .pacnew file
  -m, --merge    merge interactively with pacdiff (pacman-contrib)
  -h, --help     show this help
EOF
}

cmd_pacnew() {
    local mode=list files f
    while (( $# )); do
        case $1 in
            -d|--diff)  mode=diff ;;
            -m|--merge) mode=merge ;;
            -h|--help)  usage_pacnew; return 0 ;;
            *) die "Unknown option: $1" ;;
        esac
        shift
    done
    [[ $mode == merge ]] && { need_root; have pacdiff || die "Install 'pacman-contrib' (pacdiff)."; exec pacdiff; }
    mapfile -t files < <(list_pacfiles)
    (( ${#files[@]} )) || { info "No .pacnew/.pacsave files found."; return 0; }
    msg "${#files[@]} file(s) need attention"
    for f in "${files[@]}"; do
        printf '   %s\n' "$f"
        if [[ $mode == diff && $f == *.pacnew ]]; then
            diff -u --color=auto "${f%.pacnew}" "$f" | sed 's/^/      /'
        fi
    done
    info "Merge them with: blitz pacnew --merge"
}

# ======================================================================
#  blitz btrfs
# ======================================================================
usage_btrfs() { cat <<'EOF'
Usage: blitz btrfs [action] [options]
Actions:
  status (default)   usage, errors, scrub state, snapshot count
  usage              detailed space usage
  errors             device error counters
  scrub [start|status|cancel] [-w|--wait]
                     checksum verification (runs in background unless --wait)
  balance [-u N|--usage N] [--status|--cancel]
                     light balance of chunks filled up to N% (default 50)
EOF
}

cmd_btrfs() {
    local sub=${1:-status}
    (( $# )) && shift
    case $sub in -h|--help|help) usage_btrfs; return 0 ;; esac
    root_is_btrfs || die "The root filesystem is not btrfs."
    need_root
    case $sub in
        status|st)
            msg "btrfs status"
            btrfs filesystem show / 2>/dev/null | sed 's/^/   /'
            echo; btrfs filesystem usage -h / 2>/dev/null | sed -n '1,14p' | sed 's/^/   /'
            echo; msg "Device errors"; btrfs device stats / | sed 's/^/   /'
            echo; msg "Last scrub"; btrfs scrub status / | sed 's/^/   /'
            echo; findmnt -no OPTIONS / | tr ',' '\n' | grep -E '^(compress|subvol|ssd|discard|space_cache)' | sed 's/^/   /'
            ;;
        usage|df) btrfs filesystem usage -h / ;;
        errors|stats) btrfs device stats / ;;
        scrub)
            local act=start wait=0
            while (( $# )); do
                case $1 in
                    start|status|cancel) act=$1 ;;
                    -w|--wait) wait=1 ;;
                    *) die "Unknown option: $1" ;;
                esac
                shift
            done
            case $act in
                start) if (( wait )); then btrfs scrub start -B /; else btrfs scrub start /; info "Running in background: blitz btrfs scrub status"; fi ;;
                status) btrfs scrub status / ;;
                cancel) btrfs scrub cancel / ;;
            esac ;;
        balance)
            local usage=50 act=start
            while (( $# )); do
                case $1 in
                    -u|--usage) need_arg "$@"; usage=$2; shift ;;
                    --status)   act=status ;;
                    --cancel)   act=cancel ;;
                    *) die "Unknown option: $1" ;;
                esac
                shift
            done
            [[ $usage =~ ^[0-9]+$ ]] || die "--usage needs a number."
            case $act in
                start)  msg "Balancing chunks up to ${usage}% full"; btrfs balance start -dusage="$usage" -musage="$usage" / ;;
                status) btrfs balance status / ;;
                cancel) btrfs balance cancel / ;;
            esac ;;
        *) die "Unknown btrfs action: $sub (use blitz btrfs --help)" ;;
    esac
}

# ======================================================================
#  blitz boot
# ======================================================================
usage_boot() { cat <<'EOF'
Usage: blitz boot [options]
  (no options)       show bootloader status
  -r, --regen        regenerate the GRUB menu (including grub-btrfs snapshot entries)
  -i, --initramfs    rebuild all initramfs images (mkinitcpio or dracut)
  -a, --all          both of the above
  -h, --help         show this help
EOF
}

cmd_boot() {
    local regen=0 initramfs=0 k base mode=BIOS
    while (( $# )); do
        case $1 in
            -r|--regen)     regen=1 ;;
            -i|--initramfs) initramfs=1 ;;
            -a|--all)       regen=1; initramfs=1 ;;
            -h|--help)      usage_boot; return 0 ;;
            *) die "Unknown option: $1" ;;
        esac
        shift
    done
    if (( regen || initramfs )); then
        need_root; start_log
        if (( initramfs )); then
            msg "Rebuilding initramfs images"
            if have mkinitcpio; then mkinitcpio -P
            elif have dracut;   then dracut --regenerate-all --force
            else warn "Neither mkinitcpio nor dracut found."; fi
        fi
        (( regen )) && regen_grub
        return 0
    fi

    [[ -d /sys/firmware/efi ]] && mode=UEFI
    msg "Boot status"
    info "Mode:        $mode"
    if mountpoint -q /boot/efi; then info "ESP:         $(findmnt -no SOURCE,FSTYPE,OPTIONS /boot/efi)"; else info "ESP:         not mounted at /boot/efi"; fi
    info "/boot:       $(findmnt -no FSTYPE /boot 2>/dev/null || findmnt -no FSTYPE /) (same fs as /: $([[ -z $(findmnt -no TARGET /boot 2>/dev/null) ]] && echo yes || echo no))"
    [[ -f $GRUB_CFG ]] && info "grub.cfg:    $(date -r "$GRUB_CFG" '+%F %T')" || warn "$GRUB_CFG is missing"
    if pacman -Qq grub-btrfs >/dev/null 2>&1; then
        info "grub-btrfs:  installed ($(grep -c '^[[:space:]]*menuentry' /boot/grub/grub-btrfs.cfg 2>/dev/null || echo 0) snapshot entries)"
    else info "grub-btrfs:  not installed"; fi
    for k in /usr/lib/modules/*/pkgbase; do
        [[ -f $k ]] || continue
        base=$(<"$k")
        info "Kernel:      $base  vmlinuz: $([[ -f /boot/vmlinuz-$base ]] && echo yes || echo MISSING)  initramfs: $([[ -f /boot/initramfs-$base.img ]] && echo yes || echo MISSING)"
    done
    have efibootmgr && [[ $mode == UEFI ]] && { echo; efibootmgr 2>/dev/null | sed 's/^/   /'; }
    return 0
}

# ======================================================================
#  blitz kernel
# ======================================================================
usage_kernel() { cat <<'EOF'
Usage: blitz kernel [action]
  list (default)             installed kernels (running one is marked)
  install <name> [options]   install a kernel + headers, e.g. lts, zen, hardened
  remove  <name> [options]   remove a kernel + headers (never the running/last one)
Options:
  --no-headers   do not install/remove the headers package
  -S, --no-snapshot   skip the snapshot taken before the change
  -y, --yes      do not ask for confirmation
  --no-grub      do not regenerate the GRUB menu
EOF
}

cmd_kernel() {
    local sub=${1:-list} name="" headers=1 snap=1 k base running pkgs=() noconf=() others=0 ver
    (( $# )) && shift
    while (( $# )); do
        case $1 in
            --no-headers) headers=0 ;;
            -S|--no-snapshot) snap=0 ;;
            -y|--yes)  ASSUME_YES=1 ;;
            --no-grub) NO_GRUB=1 ;;
            -h|--help) usage_kernel; return 0 ;;
            -*) die "Unknown option: $1" ;;
            *)  name=$1 ;;
        esac
        shift
    done
    case $sub in -h|--help|help) usage_kernel; return 0 ;; esac
    running=$(uname -r)
    (( ASSUME_YES )) && noconf+=(--noconfirm)

    case $sub in
        list|ls)
            msg "Installed kernels"
            for k in /usr/lib/modules/*/; do
                ver=${k%/}; ver=${ver##*/}
                base=$(cat "$k/pkgbase" 2>/dev/null || echo "?")
                printf '   %-16s %-14s %s\n' "$base" "$ver" "$([[ $ver == "$running" ]] && echo '<- running')"
            done ;;
        install|add)
            [[ -n $name ]] || die "Usage: blitz kernel install <name>"
            [[ $name == linux* ]] || name="linux-$name"
            pacman -Si "$name" >/dev/null 2>&1 || die "Package '$name' not found in the repositories."
            need_root; start_log
            pkgs=("$name"); (( headers )) && pacman -Si "$name-headers" >/dev/null 2>&1 && pkgs+=("$name-headers")
            if (( snap )) && root_is_btrfs && snapper_ok; then
                msg "Creating snapshot"; snap_create "blitz kernel install $name" number 0 && info "Snapshot #$SNAP_NEW"
            fi
            msg "Installing ${pkgs[*]}"
            pacman -S --needed "${noconf[@]}" "${pkgs[@]}" || die "Installation failed."
            regen_grub
            msg "Done. Reboot and pick the new kernel in GRUB (Advanced options)." ;;
        remove|rm)
            [[ -n $name ]] || die "Usage: blitz kernel remove <name>"
            [[ $name == linux* ]] || name="linux-$name"
            pacman -Qq "$name" >/dev/null 2>&1 || die "Kernel package '$name' is not installed."
            base=$(cat "/usr/lib/modules/$running/pkgbase" 2>/dev/null || true)
            [[ $name == "$base" ]] && die "Refusing to remove the running kernel ($name). Boot another kernel first."
            for k in /usr/lib/modules/*/pkgbase; do
                [[ -f $k && $(<"$k") != "$name" ]] && others=$((others+1))
            done
            (( others )) || die "Refusing to remove the only installed kernel."
            need_root; start_log
            pkgs=("$name"); (( headers )) && pacman -Qq "$name-headers" >/dev/null 2>&1 && pkgs+=("$name-headers")
            confirm "Remove ${pkgs[*]}?" || die "Aborted."
            if (( snap )) && root_is_btrfs && snapper_ok; then
                msg "Creating snapshot"; snap_create "blitz kernel remove $name" number 0 && info "Snapshot #$SNAP_NEW"
            fi
            pacman -Rns "${noconf[@]}" "${pkgs[@]}" || die "Removal failed."
            regen_grub ;;
        *) die "Unknown kernel action: $sub (use blitz kernel --help)" ;;
    esac
}

# ======================================================================
#  blitz info
# ======================================================================
cmd_info() {
    case ${1:-} in -h|--help) echo "Usage: blitz info    show a system overview"; return 0 ;; esac
    detect_system
    kv() { printf '  %s%-15s%s %s\n' "$B" "$1" "$N" "$2"; }
    local b last repos aur cpu mem sn
    msg "blitzArt system information"
    kv "blitz"     "$VERSION"
    kv "OS"        "${PRETTY_NAME:-${NAME:-unknown}}"
    kv "Kernel"    "$(uname -r)"
    kv "Init"      "$INIT"
    kv "Uptime"    "$(uptime -p 2>/dev/null | sed 's/^up //')"
    cpu=$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo)
    kv "CPU"       "${cpu:-unknown} ($(nproc) threads)"
    mem=$(free -h | awk '/^Mem:/{print $3 " / " $2}')
    kv "Memory"    "$mem"
    kv "Boot mode" "$([[ -d /sys/firmware/efi ]] && echo UEFI || echo BIOS)"
    kv "Root fs"   "$(findmnt -no FSTYPE,SOURCE / | sed 's/\[.*\]//')"
    if root_is_btrfs; then
        b=$(booted_snapshot_id || true)
        if [[ -n $b ]]; then kv "Booted from" "snapshot #$b (read-only)"; else kv "Booted from" "live subvolume ($(findmnt -no OPTIONS / | grep -o 'subvol=[^,]*' | head -1 | cut -d= -f2))"; fi
        if (( EUID == 0 )) && snapper_ok; then sn=$(snap_rows | wc -l); kv "Snapshots" "$sn (snapper config '$SNAPPER_CFG')"
        else kv "Snapshots" "n/a (run as root)"; fi
    fi
    if last=$(last_upgrade_epoch); then kv "Last upgrade" "$(date -d "@$last" '+%F %T') ($(( ( $(date +%s) - last ) / 86400 )) day(s) ago)"; fi
    kv "Packages"  "$(pacman -Qnq 2>/dev/null | wc -l) native, $(pacman -Qmq 2>/dev/null | wc -l) foreign"
    repos=$(grep -oE '^\[[^]]+\]' /etc/pacman.conf | grep -v '^\[options\]' | tr -d '[]' | tr '\n' ' ')
    kv "Repositories" "$repos"
    aur=$(for h in paru yay; do have "$h" && echo -n "$h "; done)
    kv "AUR helper" "${aur:-none}"
    kv "Flatpak"   "$(have flatpak && echo installed || echo no)"
    kv "grub-btrfs" "$(pacman -Qq grub-btrfs >/dev/null 2>&1 && echo installed || echo no)"
}

# ======================================================================
#  main
# ======================================================================
usage_main() { cat <<EOF
blitz $VERSION - system toolbox for blitzArt

Usage: blitz <command> [options]

Commands:
  update,   upd, u          safe system update (snapshot, keyrings, repos, AUR, Flatpak)
  snapshot, snap, s         list | create | delete | restore | diff | prune
  restore                   shortcut for 'snapshot restore'
  health,   check, alive    check that the system is healthy
  clean                     package cache, orphans, old @.broken-* subvolumes
  mirrors                   refresh / rank mirror lists
  pacnew                    list, diff and merge .pacnew/.pacsave files
  btrfs                     status, usage, errors, scrub, balance
  boot                      bootloader status, GRUB / initramfs regeneration
  kernel                    list, install and remove kernels
  info                      system overview
  version                   print the version
  help                      this help

Run 'blitz <command> --help' for the options of a command.
EOF
}

main() {
    ORIG_ARGS=("$@")
    (( $# )) || { usage_main; exit 0; }
    local cmd=$1; shift
    case $cmd in
        update|upd|u)               cmd_update "$@" ;;
        snapshot|snap|s)            cmd_snapshot "$@" ;;
        restore)                    snapshot_restore "$@" ;;
        health|check|alive)         cmd_health "$@" ;;
        clean)                      cmd_clean "$@" ;;
        mirrors)                    cmd_mirrors "$@" ;;
        pacnew)                     cmd_pacnew "$@" ;;
        btrfs)                      cmd_btrfs "$@" ;;
        boot)                       cmd_boot "$@" ;;
        kernel)                     cmd_kernel "$@" ;;
        info)                       cmd_info "$@" ;;
        version|-V|--version)       echo "blitz $VERSION" ;;
        help|-h|--help)             usage_main ;;
        *) die "Unknown command: $cmd (use blitz help)" ;;
    esac
}

main "$@"
