#!/usr/bin/env bash
# blitzart-hyprpm-setup [--update]
#
# Installs and enables the Hyprland plugins listed in /usr/local/share/blitzart/hyprpm-plugins.list with hyprpm.
#   (no argument)  headers + add every listed repository + enable every listed plugin
#   --update       only `hyprpm update` (rebuild headers/plugins after Hyprland was upgraded), then verify
#
# WHY A STAND-IN SOCKET: hyprpm is written for a running Hyprland. `add`, `enable` and `update` ask the compositor
# for its version (j/version), for the loaded plugins (j/plugins list) and tell it to load them (/plugin load ...).
# Without a running Hyprland - a chroot during installation, a TTY, a cron job - it refuses ("Are you running
# hyprland?", "Headers outdated"). So this script starts a tiny stand-in on a private socket that answers exactly
# those questions (the version comes from the INSTALLED binary: `Hyprland --version-json`) and accepts the load
# requests. hyprpm itself still does everything real: clones Hyprland's headers, builds the plugins, keeps its state
# in ~/.local/share/hyprpm. The plugins are loaded by the real Hyprland at login (the config runs `hyprpm reload -n`).
#
# hyprpm also refuses to run as root, and needs sudo (to install the headers): run this as a normal user.
set -u

LIST=${BLITZART_HYPRPM_LIST:-/usr/local/share/blitzart/hyprpm-plugins.list}
MODE=install
case ${1:-} in
    "") ;;
    --update) MODE=update ;;
    -h|--help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "usage: blitzart-hyprpm-setup [--update]" >&2; exit 2 ;;
esac

msg()  { printf '\033[1;32m==>\033[0m \033[1m%s\033[0m\n' "$*"; }
info() { printf '  \033[1;34m->\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==> WARNING:\033[0m %s\n' "$*" >&2; }
strip_ansi() { sed 's/\x1b\[[0-9;?]*[A-Za-z]//g'; }

[[ $EUID -ne 0 ]] || { echo "Run as a regular user: hyprpm refuses to run as root." >&2; exit 1; }

# ---- prerequisites (hyprpm's own list + what the listed plugins need to compile)
missing=()
for c in hyprpm Hyprland git cmake cpio meson ninja g++ gcc make pkg-config hyprwayland-scanner python3 sudo; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
done
if ((${#missing[@]})); then
    warn "missing programs: ${missing[*]}"
    warn "install: sudo pacman -S --needed hyprland hyprpm cmake cpio meson ninja gcc make pkgconf hyprwayland-scanner glaze hyprland-protocols xorgproto git python"
    exit 1
fi
sudo -n true 2>/dev/null || { warn "passwordless sudo is not available - hyprpm needs it to install the headers (run: sudo -v first)"; exit 1; }
[[ -r $LIST ]] || { warn "plugin list not found: $LIST"; exit 1; }

PLUGINS=()   # "url|name"
while read -r url name _; do
    [[ -z $url || $url == \#* ]] && continue
    [[ -n $name ]] || { warn "bad line in $LIST: $url"; continue; }
    PLUGINS+=("$url|$name")
done <"$LIST"
((${#PLUGINS[@]})) || { warn "no plugins listed in $LIST"; exit 0; }

# ---- the stand-in "running Hyprland"
REAL_XDG=${XDG_RUNTIME_DIR:-}; REAL_HIS=${HYPRLAND_INSTANCE_SIGNATURE:-}
work=$(mktemp -d /tmp/blitzart-hyprpm.XXXXXX) || exit 1
chmod 700 "$work"
srv=""
cleanup() { [[ -n $srv ]] && kill "$srv" 2>/dev/null; rm -rf "$work"; }
trap cleanup EXIT
trap 'exit 130' INT TERM

HIS=blitzart-standin
mkdir -p "$work/hypr/$HIS"
cat >"$work/srv.py" <<'PY'
import os, socket, subprocess, sys
path = sys.argv[1]
version = subprocess.run(["Hyprland", "--version-json"], capture_output=True, text=True).stdout
if not version.strip():
    sys.exit("Hyprland --version-json printed nothing")
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.bind(path)
os.chmod(path, 0o600)
s.listen(16)
while True:
    c, _ = s.accept()
    try:
        req = c.recv(65536).decode(errors="replace").strip()
        if req.endswith("version") or req.startswith("j/version"):
            out = version
        elif req.startswith("j/plugins"):
            out = "[]"                      # nothing loaded: hyprpm then asks to load every enabled plugin
        else:
            out = "ok"                      # /plugin load, /plugin unload, /notify ...
        c.sendall(out.encode())
    except Exception:
        pass
    finally:
        c.close()
PY
python3 "$work/srv.py" "$work/hypr/$HIS/.socket.sock" 2>"$work/srv.err" &
srv=$!
for _ in $(seq 1 50); do [[ -S $work/hypr/$HIS/.socket.sock ]] && break; sleep 0.1; done
[[ -S $work/hypr/$HIS/.socket.sock ]] || { warn "could not start the stand-in socket: $(cat "$work/srv.err" 2>/dev/null)"; exit 1; }
export XDG_RUNTIME_DIR=$work HYPRLAND_INSTANCE_SIGNATURE=$HIS
info "Hyprland $(Hyprland --version-json 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("tag") or d.get("commit","?")[:8])' 2>/dev/null)"

# ---- hyprpm
failed=()
msg "hyprpm update (Hyprland headers)"
if ! hyprpm update; then
    warn "hyprpm update failed - plugins cannot be built. Re-run later: blitzart-hyprpm-setup"
    exit 1
fi

plugin_state() { hyprpm list 2>&1 | strip_ansi | awk -v n="$1" '
    $1 == "│" && $2 == "Plugin" && $3 == n { f = 1; next }
    f && /enabled:/ { sub(/.*enabled: */, ""); print; exit }'; }

if [[ $MODE == install ]]; then
    for entry in "${PLUGINS[@]}"; do
        url=${entry%%|*}; name=${entry##*|}
        msg "plugin $name ($url)"
        if [[ -n $(plugin_state "$name") ]]; then
            info "already added"
        else
            # hyprpm asks "Are you sure? [Y/n]" on stdin
            if ! printf 'y\n' | hyprpm add "$url"; then
                warn "could not add/build $name"; failed+=("$name"); continue
            fi
        fi
        hyprpm enable "$name" || { warn "could not enable $name"; failed+=("$name"); }
    done
fi

# ---- verify what hyprpm recorded
msg "Result"
for entry in "${PLUGINS[@]}"; do
    name=${entry##*|}
    st=$(plugin_state "$name")
    case $st in
        true) info "$name: enabled" ;;
        "")   warn "$name: not installed"; [[ " ${failed[*]} " == *" $name "* ]] || failed+=("$name") ;;
        *)    warn "$name: $st"; [[ " ${failed[*]} " == *" $name "* ]] || failed+=("$name") ;;
    esac
done

# when this is run inside a REAL Hyprland session, load the plugins right now
if [[ -n $REAL_XDG && -n $REAL_HIS && -S $REAL_XDG/hypr/$REAL_HIS/.socket.sock ]]; then
    info "Hyprland is running - loading the plugins into it"
    XDG_RUNTIME_DIR=$REAL_XDG HYPRLAND_INSTANCE_SIGNATURE=$REAL_HIS hyprpm reload -n \
        || warn "the running Hyprland did not load them (restart it if it was upgraded)"
fi

if ((${#failed[@]})); then
    warn "failed: ${failed[*]}  - re-run: blitzart-hyprpm-setup"
    exit 1
fi
mkdir -p "$HOME/.local/state/blitzart" && date -Is >"$HOME/.local/state/blitzart/hyprpm.ok"
msg "Hyprland plugins ready (they load when Hyprland starts)"
