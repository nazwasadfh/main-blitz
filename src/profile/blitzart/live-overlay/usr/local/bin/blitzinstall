#!/usr/bin/env bash
# blitzinstall - BlitzArt Linux installer (inspired by archinstall)
# UEFI + GPT only | btrfs (@, @snapshots, @pkg) | GRUB + grub-btrfs | dinit
set -uo pipefail

readonly VERSION="0.1.0"
readonly MNT=/mnt
readonly LOG=/var/log/blitzinstall.log
readonly SHARE=/usr/share/blitzart
readonly REPO_DIR=/opt/blitzart/repo
readonly TITLE="BlitzArt installer $VERSION"
readonly BTRFS_OPTS="noatime,compress=zstd:3,space_cache=v2"

# shellcheck disable=SC1091
. /usr/lib/blitzart/packages.sh
# shellcheck disable=SC1091
. /usr/lib/blitzart/dots.sh

# ---------------------------------------------------------------- state
HOSTNAME_V="blitzart"
DISK=""; PART_MODE="auto"; ESP_PART=""; ROOT_PART=""; FORMAT_ESP=1
KERNELS=(linux)
ROOT_PW=""; USER_NAME=""; USER_PW=""
TZ_V="UTC"; LOCALE_V="en_US.UTF-8"; KEYMAP_V="us"
EXTRA_PKGS=""
GUI=0   # "Install graphical stuff (EXPERIMENTAL)", default No

# ---------------------------------------------------------------- helpers
C=$'\e[36m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; B=$'\e[1m'; N=$'\e[0m'
msg()  { printf '%s==>%s %s%s%s\n' "$G" "$N" "$B" "$*" "$N"; }
info() { printf '%s  ->%s %s\n' "$C" "$N" "$*"; }
warn() { printf '%s==> WARNING:%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%s==> ERROR:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

[[ $EUID -eq 0 ]] || { have sudo && exec sudo -E "$0" "$@"; die "Run as root."; }
have dialog || die "dialog is missing."

DLG() { dialog --backtitle "$TITLE" "$@"; }
msgbox() { DLG --title "${2:-BlitzArt}" --msgbox "$1" 12 66; }
yesno()  { DLG --title "${2:-Confirm}" --defaultno --yesno "$1" 12 66; }
input()  { DLG --stdout --title "$1" --inputbox "$2" 10 66 "${3:-}"; }
password() { # prompt twice, echo result
    local a b
    while :; do
        a=$(DLG --stdout --title "$1" --insecure --passwordbox "Password:" 9 60) || return 1
        [[ -n $a ]] || { msgbox "Password cannot be empty."; continue; }
        b=$(DLG --stdout --title "$1" --insecure --passwordbox "Repeat password:" 9 60) || return 1
        [[ $a == "$b" ]] && { printf '%s' "$a"; return 0; }
        msgbox "Passwords do not match."
    done
}
part() { [[ $1 =~ [0-9]$ ]] && echo "${1}p$2" || echo "${1}$2"; }
ach()  { artix-chroot "$MNT" "$@"; }

# ---------------------------------------------------------------- preflight
preflight() {
    [[ -d /sys/firmware/efi/efivars ]] || { clear; die "Not booted in UEFI mode. BlitzArt requires UEFI + GPT."; }
}

have_net() {
    getent hosts artixlinux.org >/dev/null 2>&1 && curl -fsS -m 8 -o /dev/null https://artixlinux.org
}

ensure_net() {
    while ! have_net; do
        DLG --title "Network required" --menu "No internet connection.\nBlitzArt installs from the network." 12 62 3 \
            1 "Configure network (nmtui)" \
            2 "Retry" \
            3 "Abort" 2>/tmp/.ba_net || { clear; exit 1; }
        case $(</tmp/.ba_net) in
            1) nmtui ;;
            2) ;;
            3) clear; exit 1 ;;
        esac
    done
}

# ---------------------------------------------------------------- menu pickers
# real disks only. Filter by TYPE, not by major number: virtio disks (vda) use a dynamic major (often 252/253),
# which the old `-e 7,11,252` hid; zram also reports TYPE=disk, so it is dropped by name.
list_disks() {
    lsblk -dpno NAME,SIZE,TYPE,MODEL 2>/dev/null | awk '
        $3 == "disk" && $1 !~ /\/(zram|loop|ram)[0-9]*$/ {
            n=$1; sz=$2; $1=$2=$3=""; sub(/^ +/, ""); gsub(/ +/, " ")
            printf "%s\t%s\t%s\n", n, sz, $0
        }'
}

# the disk this live system booted from (empty if not found)
live_disk() {
    local src p
    src=$(findmnt -no SOURCE /run/artix/bootmnt 2>/dev/null) \
        || src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null) || src=""
    [[ -n $src ]] || src=$(findmnt -rno SOURCE -t iso9660,udf 2>/dev/null | head -n1)
    [[ -n $src ]] || return 0
    p=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1)
    [[ -n $p ]] || p=${src##*/}
    echo "$p"
}

pick_disk() {
    local items=() n s m live
    live=$(live_disk)
    while IFS=$'\t' read -r n s m; do
        [[ -n $live && $n == "/dev/$live" ]] && m="$m  <-- LIVE MEDIUM"
        items+=("$n" "$s ${m:-}")
    done < <(list_disks)
    ((${#items[@]})) || { msgbox "No disks found."; return 1; }
    DLG --stdout --title "Disk" --menu "Select the installation disk:" 18 70 8 "${items[@]}"
}

pick_part() { # $1 = disk, $2 = prompt
    local items=() n s f
    while read -r n s f; do items+=("$n" "$s ${f:--}"); done < <(lsblk -pnlo NAME,SIZE,FSTYPE "$1" | tail -n +2)
    ((${#items[@]})) || { msgbox "No partitions on $1."; return 1; }
    DLG --stdout --title "Partition" --menu "$2" 18 70 8 "${items[@]}"
}

cfg_disk() {
    local d mode
    mode=$(DLG --stdout --title "Disk configuration" --menu "Layout: GPT, 1G ESP (/boot/efi) + btrfs root.\nNo separate /home." 13 66 2 \
        auto   "Wipe the whole disk and partition automatically" \
        manual "Use existing GPT partitions") || return
    d=$(pick_disk) || return
    local live; live=$(live_disk)
    if [[ -n $live && $d == "/dev/$live" ]]; then
        yesno "$d is the medium this live system booted from.\nInstalling there destroys the running live system.\n\nContinue anyway?" "Live medium" || return
    fi
    if [[ $mode == manual ]]; then
        if [[ $(lsblk -dno PTTYPE "$d") != gpt ]]; then
            msgbox "$d does not have a GPT partition table.\nBlitzArt requires GPT. Use automatic mode or convert the disk first."
            return
        fi
        yesno "Edit partitions with cfdisk first?" "Partitioning" && cfdisk "$d"
        ESP_PART=$(pick_part "$d" "Select the EFI System Partition (ESP):") || return
        ROOT_PART=$(pick_part "$d" "Select the partition for the btrfs ROOT (will be formatted):") || return
        [[ $ESP_PART != "$ROOT_PART" ]] || { msgbox "ESP and root must differ."; return; }
        if [[ $(lsblk -no FSTYPE "$ESP_PART") == vfat ]] && ! yesno "Format the existing ESP $ESP_PART?\n(No = keep it, e.g. for dual-boot)" "ESP"; then
            FORMAT_ESP=0
        else
            FORMAT_ESP=1
        fi
    else
        ESP_PART=""; ROOT_PART=""; FORMAT_ESP=1
    fi
    DISK=$d; PART_MODE=$mode
}

cfg_kernels() {
    local sel
    sel=$(DLG --stdout --title "Kernels" --checklist "Select kernel(s) (space = toggle):" 13 60 4 \
        linux     "Mainline (default)"   "$([[ " ${KERNELS[*]} " == *" linux "* ]] && echo on || echo off)" \
        linux-lts "Long term support"    "$([[ " ${KERNELS[*]} " == *" linux-lts "* ]] && echo on || echo off)" \
        linux-zen "Zen (desktop tuned)"  "$([[ " ${KERNELS[*]} " == *" linux-zen "* ]] && echo on || echo off)") || return
    # shellcheck disable=SC2206
    sel=(${sel//\"/})
    ((${#sel[@]})) || { msgbox "Select at least one kernel."; return; }
    KERNELS=("${sel[@]}")
}

cfg_timezone() {
    local regions=() r cities=() c
    while read -r r; do regions+=("$r" ""); done < <(find /usr/share/zoneinfo -mindepth 1 -maxdepth 1 -type d \
        ! -name posix ! -name right ! -name Etc -printf '%f\n' | sort)
    r=$(DLG --stdout --title "Timezone" --menu "Region:" 20 50 12 "${regions[@]}" UTC "") || return
    if [[ $r == UTC ]]; then TZ_V=UTC; return; fi
    while read -r c; do cities+=("$c" ""); done < <(find "/usr/share/zoneinfo/$r" -type f -printf '%P\n' | sort)
    c=$(DLG --stdout --title "Timezone" --menu "City:" 20 50 12 "${cities[@]}") || return
    TZ_V="$r/$c"
}

cfg_locale() {
    local l k
    l=$(input "Locale" "Locale (must exist in /etc/locale.gen):" "$LOCALE_V") || return
    grep -qE "^#?${l//./\\.} " /etc/locale.gen || { msgbox "Unknown locale: $l"; return; }
    k=$(input "Keymap" "Console keymap (e.g. us, pl, de-latin1):" "$KEYMAP_V") || return
    grep -q . < <(find /usr/share/kbd/keymaps -name "$k.map*" 2>/dev/null) || { msgbox "Unknown keymap: $k"; return; }
    LOCALE_V=$l; KEYMAP_V=$k
    loadkeys "$k" 2>/dev/null || true
}

cfg_user() {
    local u p
    u=$(input "User account" "Username (lowercase):" "$USER_NAME") || return
    [[ $u =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { msgbox "Invalid username."; return; }
    [[ $u != root ]] || { msgbox "Pick a regular user (root is configured separately)."; return; }
    p=$(password "Password for $u") || return
    USER_NAME=$u; USER_PW=$p
}

# ---------------------------------------------------------------- main menu
status() { [[ -n $1 ]] && echo "$1" || echo "(not set)"; }

cfg_gui() {
    if DLG --title "Graphical stuff (EXPERIMENTAL)" --defaultno --yesno \
"Install the graphical stack?\n
  - SDDM (theme: sddm-slice), enabled at boot
  - Hyprland + illogical-impulse (end-4) + end4-pC
  - your hypr config on top of it
  - kitty, dolphin, brave (downloaded)\n
This is experimental. Choose No for the plain console system." 17 66; then
        GUI=1
    else
        GUI=0
    fi
}

main_menu() {
    local choice disk_s gui_s
    while :; do
        if [[ -z $DISK ]]; then disk_s="(not set)"
        elif [[ $PART_MODE == auto ]]; then disk_s="auto: $DISK"
        else disk_s="manual: $ESP_PART + $ROOT_PART"; fi
        ((GUI)) && gui_s=Yes || gui_s=No
        choice=$(DLG --stdout --title "BlitzArt Linux" --cancel-label "Abort" --menu \
            "Configure the installation, then choose Install." 24 76 12 \
            1 "Hostname              [$HOSTNAME_V]" \
            2 "Disk configuration    [$disk_s]" \
            3 "Kernels               [${KERNELS[*]}]" \
            4 "Root password         [$([[ -n $ROOT_PW ]] && echo set || echo '(not set)')]" \
            5 "User account          [$(status "$USER_NAME")]" \
            6 "Timezone              [$TZ_V]" \
            7 "Locale / keymap       [$LOCALE_V / $KEYMAP_V]" \
            8 "Additional packages   [${EXTRA_PKGS:-none}]" \
            9 "Install graphical stuff (EXPERIMENTAL)  [$gui_s]" \
            i ">> Install" \
            0 "Abort") || { clear; exit 0; }
        case $choice in
            1) local h; h=$(input "Hostname" "Hostname:" "$HOSTNAME_V") && [[ $h =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]] && HOSTNAME_V=$h ;;
            2) cfg_disk ;;
            3) cfg_kernels ;;
            4) ROOT_PW=$(password "Root password") || true ;;
            5) cfg_user ;;
            6) cfg_timezone ;;
            7) cfg_locale ;;
            8) EXTRA_PKGS=$(input "Additional packages" "Extra packages (space separated, from any enabled repo):" "$EXTRA_PKGS") || true ;;
            9) cfg_gui ;;
            i) validate && return 0 ;;
            0) clear; exit 0 ;;
        esac
    done
}

validate() {
    local miss=()
    [[ -n $DISK ]]      || miss+=("disk")
    [[ -n $ROOT_PW ]]   || miss+=("root password")
    [[ -n $USER_NAME ]] || miss+=("user account")
    if ((${#miss[@]})); then msgbox "Still missing: ${miss[*]}"; return 1; fi
    local summary="Disk:     $DISK ($PART_MODE)\nHostname: $HOSTNAME_V\nKernels:  ${KERNELS[*]}\nUser:     $USER_NAME\nTimezone: $TZ_V\nLocale:   $LOCALE_V / $KEYMAP_V"
    ((GUI)) && summary+="\nGraphical: Yes (EXPERIMENTAL: SDDM, Hyprland, illogical-impulse, end4-pC, kitty, dolphin, brave)"
    if [[ $PART_MODE == auto ]]; then
        summary+="\n\n!! ALL DATA ON $DISK WILL BE DESTROYED (blkdiscard + new GPT) !!"
    else
        summary+="\n\n!! $ROOT_PART WILL BE FORMATTED !!"
    fi
    yesno "$summary\n\nProceed?" "Final confirmation"
}

# ---------------------------------------------------------------- install phases
phase_disk() {
    msg "Preparing disk"
    umount -R "$MNT" 2>/dev/null || true
    swapoff -a 2>/dev/null || true
    if [[ $PART_MODE == auto ]]; then
        info "blkdiscard -fv $DISK"
        blkdiscard -fv "$DISK" || warn "blkdiscard failed or unsupported - continuing"
        sgdisk --zap-all "$DISK" >/dev/null
        sgdisk -n1:0:+1G -t1:EF00 -c1:ESP \
               -n2:0:0   -t2:8300 -c2:BlitzArt "$DISK" || die "partitioning failed"
        partprobe "$DISK"; udevadm settle
        ESP_PART=$(part "$DISK" 1); ROOT_PART=$(part "$DISK" 2)
        FORMAT_ESP=1
    fi
    ((FORMAT_ESP)) && { info "mkfs.fat $ESP_PART"; mkfs.fat -F32 -n ESP "$ESP_PART" || die "mkfs.fat failed"; }
    info "mkfs.btrfs $ROOT_PART"
    mkfs.btrfs -f -L BLITZART "$ROOT_PART" || die "mkfs.btrfs failed"

    mkdir -p "$MNT"
    mount "$ROOT_PART" "$MNT" || die "mount failed"
    local sv
    for sv in @ @snapshots @pkg; do btrfs subvolume create "$MNT/$sv" || die "subvolume $sv failed"; done
    umount "$MNT"

    mount -o "$BTRFS_OPTS,subvol=@" "$ROOT_PART" "$MNT"
    mkdir -p "$MNT/boot/efi" "$MNT/.snapshots" "$MNT/var/cache/pacman/pkg"
    mount -o "$BTRFS_OPTS,subvol=@snapshots" "$ROOT_PART" "$MNT/.snapshots"
    mount -o "$BTRFS_OPTS,subvol=@pkg"       "$ROOT_PART" "$MNT/var/cache/pacman/pkg"
    mount "$ESP_PART" "$MNT/boot/efi" || die "cannot mount ESP"
    chmod 750 "$MNT/.snapshots"
}

write_install_conf() { # pacman.conf used by basestrap: local repo first, then artix + arch
    local f=$1
    {
        cat <<'EOF'
[options]
HoldPkg      = pacman glibc
Architecture = auto
Color
ILoveCandy
CheckSpace
VerbosePkgLists
ParallelDownloads = 5
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional

EOF
        if [[ -f $REPO_DIR/blitzart-local.db.tar.zst || -f $REPO_DIR/blitzart-local.db ]]; then
            printf '[blitzart-local]\nSigLevel = Required DatabaseOptional\nServer = file://%s\n\n' "$REPO_DIR"
        fi
        cat <<'EOF'
[system]
Include = /etc/pacman.d/mirrorlist

[world]
Include = /etc/pacman.d/mirrorlist

[galaxy]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist-arch

[multilib]
Include = /etc/pacman.d/mirrorlist-arch
EOF
    } >"$f"
}

phase_base() {
    msg "Preparing keyrings"
    pacman-key --init >/dev/null 2>&1 || true
    pacman-key --populate artix archlinux >/dev/null 2>&1 || warn "keyring populate reported problems"

    local conf=/tmp/blitzart-pacman.conf
    write_install_conf "$conf"
    local pkgs=("${BA_BASE_PKGS[@]}" "${BA_TOOLS_PKGS[@]}" "${KERNELS[@]}")
    # shellcheck disable=SC2206
    pkgs+=($EXTRA_PKGS)
    local k; for k in "${KERNELS[@]}"; do pkgs+=("$k-headers"); done   # DKMS needs them
    msg "Installing base system (${#pkgs[@]} packages)"
    basestrap -C "$conf" "$MNT" "${pkgs[@]}" || die "basestrap failed"

    msg "Generating fstab"
    fstabgen -U "$MNT" >"$MNT/etc/fstab"
    # root must NOT carry subvol=/subvolid= so that booting a snapshot (rootflags=...) works
    awk 'BEGIN{OFS="\t"} $2=="/" && $3=="btrfs" { n=split($4,o,","); s=""; for(i=1;i<=n;i++) if (o[i] !~ /^subvol(id)?=/) s=s (s?",":"") o[i]; $4=s } {print}' \
        "$MNT/etc/fstab" >"$MNT/etc/fstab.new" && mv "$MNT/etc/fstab.new" "$MNT/etc/fstab"
}

enable_svc() {
    local s=$1
    # dinit resolves boot.d entries by NAME through its service dirs, so the unit may live in /usr/lib/dinit.d
    if [[ -e $MNT/etc/dinit.d/$s || -e $MNT/usr/lib/dinit.d/$s || -e $MNT/usr/local/lib/dinit.d/$s ]]; then
        mkdir -p "$MNT/etc/dinit.d/boot.d"
        ln -sf "../$s" "$MNT/etc/dinit.d/boot.d/$s"
        info "enabled service: $s"
    else
        warn "service '$s' not found in /etc/dinit.d - skipped"
    fi
}

phase_configure() {
    msg "Configuring system"
    # --- pacman.conf (final): artix + arch + chaotic-aur + blackarch
    install -Dm644 /etc/pacman.d/mirrorlist "$MNT/etc/pacman.d/mirrorlist" 2>/dev/null || true
    [[ -f /etc/pacman.d/mirrorlist-arch ]] && install -Dm644 /etc/pacman.d/mirrorlist-arch "$MNT/etc/pacman.d/mirrorlist-arch"
    cat >"$MNT/etc/pacman.conf" <<'EOF'
[options]
HoldPkg      = pacman glibc
Architecture = auto
Color
ILoveCandy
CheckSpace
VerbosePkgLists
ParallelDownloads = 5
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional

[system]
Include = /etc/pacman.d/mirrorlist

[world]
Include = /etc/pacman.d/mirrorlist

[galaxy]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist-arch

[multilib]
Include = /etc/pacman.d/mirrorlist-arch
EOF

    # --- identity
    echo "$HOSTNAME_V" >"$MNT/etc/hostname"
    cat >"$MNT/etc/hosts" <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME_V.localdomain $HOSTNAME_V
EOF
    ln -sf "/usr/share/zoneinfo/$TZ_V" "$MNT/etc/localtime"
    ach hwclock --systohc 2>/dev/null || true
    sed -i -E "s/^#(${LOCALE_V//./\\.} )/\1/; s/^#(en_US\.UTF-8 )/\1/" "$MNT/etc/locale.gen"
    ach locale-gen >/dev/null
    echo "LANG=$LOCALE_V" >"$MNT/etc/locale.conf"
    echo "KEYMAP=$KEYMAP_V" >"$MNT/etc/vconsole.conf"

    # --- branding
    install -Dm755 "$SHARE/blitzart-brand" "$MNT/usr/local/bin/blitzart-brand"
    install -Dm644 "$SHARE/blitzart-os-release.hook" "$MNT/etc/pacman.d/hooks/blitzart-os-release.hook"
    ach /usr/local/bin/blitzart-brand
    printf '\n  BlitzArt\n\n' >"$MNT/etc/motd"

    # --- users
    msg "Creating users"
    echo "root:$ROOT_PW" | ach chpasswd
    ach useradd -m -G wheel,audio,video,storage,input,optical -s /usr/bin/zsh "$USER_NAME" || die "useradd failed"
    echo "$USER_NAME:$USER_PW" | ach chpasswd
    install -Dm440 /dev/stdin "$MNT/etc/sudoers.d/10-wheel" <<<'%wheel ALL=(ALL:ALL) ALL'
    ach chsh -s /usr/bin/zsh root

    # --- dots (from the ISO, no download)
    msg "Copying configs"
    blitzart_apply_dots "$MNT/etc/skel"
    blitzart_apply_dots "$MNT/root"
    blitzart_apply_dots "$MNT/home/$USER_NAME"
    # --- per-user dinit services (pipewire & co): boot.d entries for the user and for /etc/skel
    local home svc udir
    for home in "$MNT/etc/skel" "$MNT/home/$USER_NAME"; do
        mkdir -p "$home/.config/dinit.d/boot.d"
        for svc in "${BA_USER_SERVICES[@]}"; do
            udir=""
            for d in /etc/dinit.d/user /usr/lib/dinit.d/user /usr/local/lib/dinit.d/user; do
                [[ -e $MNT$d/$svc ]] && { udir=$d; break; }
            done
            [[ -n $udir ]] || { warn "user service '$svc' not found (is ${svc}-dinit installed?)"; continue; }
            ln -sfn "$udir/$svc" "$home/.config/dinit.d/boot.d/$svc"
            info "enabled user service: $svc"
        done
    done
    ach chown -R "$USER_NAME:$USER_NAME" "/home/$USER_NAME"

    # --- blitz toolbox
    install -Dm755 /usr/local/bin/blitz "$MNT/usr/local/bin/blitz"

    # --- snapper (config name 'root', as blitz expects) + cleanup
    msg "Configuring snapper / grub-btrfs"
    install -Dm644 "$MNT/usr/share/snapper/config-templates/default" "$MNT/etc/snapper/configs/root"
    sed -i -E \
        -e 's|^SUBVOLUME=.*|SUBVOLUME="/"|' \
        -e 's|^FSTYPE=.*|FSTYPE="btrfs"|' \
        -e 's|^QGROUP=.*|QGROUP=""|' \
        -e 's|^ALLOW_GROUPS=.*|ALLOW_GROUPS="wheel"|' \
        -e 's|^SYNC_ACL=.*|SYNC_ACL="yes"|' \
        -e 's|^TIMELINE_CREATE=.*|TIMELINE_CREATE="no"|' \
        -e 's|^NUMBER_CLEANUP=.*|NUMBER_CLEANUP="yes"|' \
        -e 's|^NUMBER_LIMIT=.*|NUMBER_LIMIT="50"|' \
        -e 's|^NUMBER_LIMIT_IMPORTANT=.*|NUMBER_LIMIT_IMPORTANT="10"|' \
        "$MNT/etc/snapper/configs/root"
    mkdir -p "$MNT/etc/conf.d"
    echo 'SNAPPER_CONFIGS="root"' >"$MNT/etc/conf.d/snapper"
    mkdir -p "$MNT/etc/cron.daily"
    printf '#!/bin/sh\nsnapper --no-dbus -c root cleanup number >/dev/null 2>&1\n' >"$MNT/etc/cron.daily/snapper-cleanup"
    chmod 755 "$MNT/etc/cron.daily/snapper-cleanup"

    install -Dm755 "$SHARE/blitzart-grub-btrfsd" "$MNT/usr/local/bin/blitzart-grub-btrfsd"
    install -Dm644 "$SHARE/grub-btrfsd.dinit" "$MNT/etc/dinit.d/grub-btrfsd"

    # --- services
    local s
    for s in dbus elogind NetworkManager acpid cronie chronyd dinit-user-spawn grub-btrfsd; do enable_svc "$s"; done
}

phase_repos() { # chaotic-aur + blackarch: keys and pacman.conf entries only (the upgrade is phase_upgrade)
    msg "Adding chaotic-aur and blackarch"
    ach pacman-key --init >/dev/null 2>&1
    ach pacman-key --populate artix archlinux >/dev/null 2>&1

    # chaotic-aur
    if ach pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com \
       && ach pacman-key --lsign-key 3056513887B78AEB \
       && ach pacman -U --noconfirm \
            https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst \
            https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst; then
        printf '\n[chaotic-aur]\nInclude = /etc/pacman.d/chaotic-mirrorlist\n' >>"$MNT/etc/pacman.conf"
    else
        warn "chaotic-aur setup failed - add it later"
    fi

    # blackarch: default SigLevel (Required DatabaseOptional). The master key is locally signed; the rest of
    # the keys arrive with blackarch-keyring (installed in phase_upgrade).
    local ba_fpr=4345771566D76038C7FEB43863EC0ADBEA87E4E3
    if ach pacman-key --recv-key "$ba_fpr" --keyserver keyserver.ubuntu.com \
       && ach pacman-key --lsign-key "$ba_fpr"; then
        cat >"$MNT/etc/pacman.d/blackarch-mirrorlist" <<'EOF'
Server = https://blackarch.org/blackarch/$repo/os/$arch
EOF
        printf '\n[blackarch]\nInclude = /etc/pacman.d/blackarch-mirrorlist\n' >>"$MNT/etc/pacman.conf"
    else
        warn "blackarch setup failed - add it later"
    fi
}

# Everything that comes from the ISO's offline repo is installed BEFORE this (older, but consistent with each
# other). Only then is the whole system brought up to date, so a later `pacman -S <net package>` can never mix
# fresh libraries with old ones (a partial upgrade: Qt/KF6 for dolphin, mesa, ...).
phase_upgrade() {
    msg "Upgrading the system (the offline repo is older than the mirrors)"
    ach pacman -Syu --noconfirm || warn "pacman -Syu failed - run it after the first boot"
    if grep -q '^\[blackarch\]' "$MNT/etc/pacman.conf"; then
        { ach pacman -S --noconfirm --needed blackarch-keyring && ach pacman-key --populate blackarch; } \
            || warn "blackarch-keyring failed - [blackarch] packages will fail signature checks until you fix the keyring"
    fi
    if grep -q '^\[chaotic-aur\]' "$MNT/etc/pacman.conf"; then
        ach pacman -S --noconfirm --needed paru || warn "paru not installed"
    fi
}

gui_dark_theme() { # EXPERIMENTAL GUI only: dark theme for GTK, Qt6 and KDE apps
    local u=$1 home
    # system-wide: Qt platform theme + dark GTK (login sessions source /etc/profile.d; /etc/environment via PAM)
    mkdir -p "$MNT/etc/profile.d"
    cat >"$MNT/etc/profile.d/blitzart-dark.sh" <<'EOF'
export QT_QPA_PLATFORMTHEME=kde
export GTK_THEME=Adwaita:dark
EOF
    printf 'QT_QPA_PLATFORMTHEME=kde\nGTK_THEME=Adwaita:dark\n' >>"$MNT/etc/environment"

    # dconf system default (GTK4 / libadwaita / xdg-desktop-portal-gtk settings portal)
    mkdir -p "$MNT/etc/dconf/profile" "$MNT/etc/dconf/db/local.d"
    printf 'user-db:user\nsystem-db:local\n' >"$MNT/etc/dconf/profile/user"
    cat >"$MNT/etc/dconf/db/local.d/00-blitzart-dark" <<'EOF'
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='Adwaita'
EOF
    ach dconf update 2>/dev/null || warn "dconf update failed (GTK4 dark default may be missing)"

    for home in "$MNT/etc/skel" "$MNT/home/$u"; do
        mkdir -p "$home/.config/gtk-3.0" "$home/.config/gtk-4.0"
        cat >"$home/.config/gtk-3.0/settings.ini" <<'EOF'
[Settings]
gtk-application-prefer-dark-theme=1
gtk-theme-name=Adwaita-dark
gtk-icon-theme-name=Adwaita
EOF
        cat >"$home/.config/gtk-4.0/settings.ini" <<'EOF'
[Settings]
gtk-application-prefer-dark-theme=1
gtk-icon-theme-name=Adwaita
EOF
        # KDE apps (dolphin) read their colours from kdeglobals
        if [[ -f $MNT/usr/share/color-schemes/BreezeDark.colors ]]; then
            cp "$MNT/usr/share/color-schemes/BreezeDark.colors" "$home/.config/kdeglobals"
            printf '\n[Icons]\nTheme=breeze-dark\n\n[KDE]\nwidgetStyle=Breeze\n' >>"$home/.config/kdeglobals"
        else
            warn "BreezeDark.colors not found - dolphin will not get the dark scheme"
        fi
    done
    # Dolphin wrapper: guarantees the dark platform theme even when the session did not inherit
    # /etc/profile.d (menu entries and keybindings call plain `dolphin`; /usr/local/bin comes first in PATH)
    mkdir -p "$MNT/usr/local/bin"
    cat >"$MNT/usr/local/bin/dolphin" <<'EOF'
#!/bin/sh
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-kde}"
export XCURSOR_THEME="${XCURSOR_THEME:-Bibata-Modern-Classic}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
exec /usr/bin/dolphin "$@"
EOF
    chmod 755 "$MNT/usr/local/bin/dolphin"
    info "dark theme configured (GTK, Qt6/KDE via plasma-integration)"
}

gui_cursor_theme() { # EXPERIMENTAL GUI only: Bibata-Modern-Classic for Wayland, X11 and XWayland
    local u=$1 home theme=Bibata-Modern-Classic size=24 f=$SHARE/cursors/Bibata-Modern-Classic.tar.xz
    if [[ ! -f $f ]]; then warn "cursor theme is missing from this ISO - skipped"; return 0; fi
    mkdir -p "$MNT/usr/share/icons"
    rm -rf "$MNT/usr/share/icons/$theme"
    tar -xf "$f" -C "$MNT/usr/share/icons" || { warn "could not unpack the cursor theme"; return 0; }
    chmod -R a+rX "$MNT/usr/share/icons/$theme"

    # X11 / XWayland default (apps that ignore the environment)
    mkdir -p "$MNT/usr/share/icons/default"
    printf '[Icon Theme]\nInherits=%s\n' "$theme" >"$MNT/usr/share/icons/default/index.theme"

    # Wayland compositors + X toolkits + XWayland all read XCURSOR_*
    cat >"$MNT/etc/profile.d/blitzart-cursor.sh" <<EOF
export XCURSOR_THEME=$theme
export XCURSOR_SIZE=$size
EOF
    printf 'XCURSOR_THEME=%s\nXCURSOR_SIZE=%s\n' "$theme" "$size" >>"$MNT/etc/environment"

    # GTK (settings.ini) + dconf default
    for home in "$MNT/etc/skel" "$MNT/home/$u"; do
        for f in "$home/.config/gtk-3.0/settings.ini" "$home/.config/gtk-4.0/settings.ini"; do
            [[ -f $f ]] && printf 'gtk-cursor-theme-name=%s\ngtk-cursor-theme-size=%s\n' "$theme" "$size" >>"$f"
        done
    done
    mkdir -p "$MNT/etc/dconf/db/local.d"
    cat >"$MNT/etc/dconf/db/local.d/01-blitzart-cursor" <<EOF
[org/gnome/desktop/interface]
cursor-theme='$theme'
cursor-size=$size
EOF
    ach dconf update 2>/dev/null || warn "dconf update failed"
    info "cursor theme: $theme ($size)"
}

phase_gui() { # EXPERIMENTAL: only runs when GUI=1; with GUI=0 the install is unchanged
    ((GUI)) || return 0
    msg "Installing graphical stack (EXPERIMENTAL)"
    local u=$USER_NAME

    # sddm + hyprland + deps: from the offline repo on the ISO (basestrap -C = local repo first)
    if ! basestrap -C /tmp/blitzart-pacman.conf "$MNT" "${BA_GUI_PKGS[@]}"; then
        warn "graphical packages failed to install - skipping the graphical setup"
        return 0
    fi

    # sddm system user (in case the sysusers hook did not run in the chroot)
    ach id sddm >/dev/null 2>&1 || ach useradd -r -M -d /var/lib/sddm -s /usr/bin/nologin -G video sddm 2>/dev/null || true

    # sddm-slice theme (bundled into the ISO at build time, no download)
    if [[ -d $SHARE/sddm-theme/sddm-slice ]]; then
        mkdir -p "$MNT/usr/share/sddm/themes"
        rm -rf "$MNT/usr/share/sddm/themes/sddm-slice"
        cp -r "$SHARE/sddm-theme/sddm-slice" "$MNT/usr/share/sddm/themes/sddm-slice"
        local md="$MNT/usr/share/sddm/themes/sddm-slice/metadata.desktop"
        if [[ -f $md ]]; then   # force the Qt6 greeter (avoids "Library import requires a version")
            if grep -q '^QtVersion=' "$md"; then sed -i 's/^QtVersion=.*/QtVersion=6/' "$md"
            else sed -i -e '$a\' "$md"; echo 'QtVersion=6' >>"$md"; fi
        fi
        printf '[Theme]\nCurrent=sddm-slice\n' >"$MNT/etc/sddm.conf"
        info "sddm theme: sddm-slice"
    else
        warn "sddm-slice theme is missing from this ISO - sddm will use its default theme"
    fi
    enable_svc sddm

    gui_dark_theme "$u"
    gui_cursor_theme "$u"

    ach chown -R "$u:$u" "/home/$u"
}

phase_gui_net() { # EXPERIMENTAL: after the full upgrade
    ((GUI)) || return 0
    # kitty, dolphin: network; brave: chaotic-aur
    ach pacman -S --noconfirm --needed "${BA_GUI_NET_PKGS[@]}" || warn "could not install: ${BA_GUI_NET_PKGS[*]}"
    if grep -q '^\[chaotic-aur\]' "$MNT/etc/pacman.conf"; then
        ach pacman -S --noconfirm --needed "${BA_GUI_CHAOTIC_PKGS[@]}" || warn "could not install brave (chaotic-aur)"
    else
        warn "chaotic-aur is not configured - brave was not installed (run: sudo pacman -S brave-bin later)"
    fi
}

# ---- illogical-impulse (end-4/dots-hyprland) + end4-pC ------------------------------------------------
# Prebuilt AUR packages cached from chaotic-aur at ISO build time: installed from the ISO through a temporary
# local repo inside the target (the chaotic key was trusted by phase_repos).
ii_cached_aur_packages() {
    ((${#BA_II_CHAOTIC_PKGS[@]})) && [[ -d $REPO_DIR ]] || return 0
    if ! grep -q '^\[chaotic-aur\]' "$MNT/etc/pacman.conf"; then
        warn "chaotic-aur is not configured - the AUR dependencies will be built by yay instead"
        return 0
    fi
    local conf=$MNT/etc/pacman.conf p
    cp "$conf" "$conf.blitzart-bak"
    mkdir -p "$MNT/opt/blitzart/repo"
    mount --bind "$REPO_DIR" "$MNT/opt/blitzart/repo" || { warn "cannot expose the offline repo"; rm -f "$conf.blitzart-bak"; return 0; }
    sed -i '0,/^\[system\]/s||[blitzart-local]\nSigLevel = Required DatabaseOptional\nServer = file:///opt/blitzart/repo\n\n[system]|' "$conf"
    ach pacman -Sy --noconfirm >/dev/null 2>&1 || warn "pacman -Sy failed"
    for p in "${BA_II_CHAOTIC_PKGS[@]}"; do
        ach pacman -S --noconfirm --needed "$p" || warn "not installed from the ISO cache: $p"
    done
    mv "$conf.blitzart-bak" "$conf"
    umount "$MNT/opt/blitzart/repo" 2>/dev/null; rmdir "$MNT/opt/blitzart/repo" "$MNT/opt/blitzart" 2>/dev/null
    rm -f "$MNT/var/lib/pacman/sync/blitzart-local.db"
}

# What ii's sdata/subcmd-install/2.setups.sh does on dinit. Its own version needs a RUNNING dinit
# (dinitctl enable ...), which a chroot does not have, so the same effects are written directly.
ii_dinit_setups() {
    local u=$1 s
    ach getent group i2c >/dev/null 2>&1 || ach groupadd i2c
    ach usermod -aG video,i2c,input "$u"
    grep -qx i2c-dev "$MNT/etc/modules" 2>/dev/null || echo i2c-dev >>"$MNT/etc/modules"
    mkdir -p "$MNT/var/log/dinit" "$MNT/etc/dinit.d"
    cat >"$MNT/etc/dinit.d/ydotool" <<'EOF'
type = process
command = /usr/bin/ydotoold
logfile = /var/log/dinit/ydotool.log
depends-on = dbus
smooth-recovery = true
EOF
    for s in bluetoothd ydotool; do enable_svc "$s"; done
}

phase_ii_offline() { # EXPERIMENTAL: what comes from the ISO's offline repo (runs BEFORE the full upgrade)
    ((GUI)) || return 0
    [[ -f $SHARE/dots-hyprland.tar.xz ]] || return 0
    msg "Installing illogical-impulse dependencies (from the ISO)"
    # 1) official dependencies from the offline repo (verified with the live keyring)
    if ((${#BA_II_PKGS[@]})); then
        basestrap -C /tmp/blitzart-pacman.conf "$MNT" "${BA_II_PKGS[@]}" \
            || warn "some illogical-impulse dependencies failed to install (ii will retry them)"
    fi
    # 2) prebuilt AUR dependencies cached in the ISO
    ii_cached_aur_packages
}

phase_ii() { # EXPERIMENTAL, graphical option only (runs AFTER the full upgrade)
    ((GUI)) || return 0
    local u=$USER_NAME h=$MNT/home/$USER_NAME rc
    if [[ ! -f $SHARE/dots-hyprland.tar.xz ]]; then
        warn "dots-hyprland is missing from this ISO - skipping illogical-impulse"
        return 0
    fi
    msg "Installing illogical-impulse (bundled in the ISO)"

    # 3) the repo exactly where ii's own `get` script would put it (also lets you `git pull` + `./setup install` later)
    mkdir -p "$h/.cache/dots-hyprland"
    tar -xJf "$SHARE/dots-hyprland.tar.xz" -C "$h/.cache/dots-hyprland" \
        || { warn "cannot unpack dots-hyprland"; return 0; }
    ach chown -R "$u:$u" "/home/$u/.cache"

    # 4) run the official installer: dependencies (yay + PKGBUILDs: quickshell, microtex, AUR leftovers) + config files.
    #    Setups are replicated below (needs a running dinit). `x()` in ii asks [R/e/i] when a command fails and
    #    would loop forever without a terminal, so it is answered with "i" (ignore); a time limit guards the rest.
    install -Dm440 /dev/stdin "$MNT/etc/sudoers.d/99-blitzart-install" <<<"$u ALL=(ALL:ALL) NOPASSWD: ALL"
    yes i 2>/dev/null | timeout 4h artix-chroot "$MNT" runuser -l "$u" -c \
        'cd ~/.cache/dots-hyprland && ./setup install --force --skip-sysupdate --skip-plasmaintg --skip-fish --skip-allsetups'
    rc=${PIPESTATUS[1]}
    rm -f "$MNT/etc/sudoers.d/99-blitzart-install"
    ((rc == 0)) || warn "the illogical-impulse installer exited with $rc (see the log); re-run it later: cd ~/.cache/dots-hyprland && ./setup install"

    # 5) end4-pC AFTER ii: ii's files step rsyncs --delete over the whole ~/.config/quickshell
    mkdir -p "$h/.config/quickshell/end4-pC"
    tar -xJf "$SHARE/end4-pC.tar.xz" -C "$h/.config/quickshell/end4-pC" || warn "cannot unpack end4-pC"

    # 6) dinit equivalents of ii's setups + the python venv (network: uv fetches python 3.12 and the wheels)
    ii_dinit_setups "$u"
    artix-chroot "$MNT" runuser -l "$u" -c '
        export UV_NO_MODIFY_PATH=1
        V=$HOME/.local/state/quickshell/.venv
        mkdir -p "$V"
        uv venv --prompt .venv "$V" -p 3.12 || true
        . "$V/bin/activate" && uv pip install -r "$HOME/.cache/dots-hyprland/sdata/uv/requirements.txt"
    ' || warn "the python venv for the shell could not be created (run ii's ./setup install-setups later)"

    # 7) priority: the user's dots (kitty, fastfetch, eza, starship, .zshrc, hypr) are applied LAST, over ii's
    blitzart_apply_dots "$h"
    blitzart_apply_hypr "$h"
    ach chown -R "$u:$u" "/home/$u"
    info "illogical-impulse + end4-pC installed; your dots were applied on top"
}

phase_boot() {
    msg "Enabling pacman snapshots (pre/post)"
    install -Dm755 "$SHARE/blitzart-snap" "$MNT/usr/local/bin/blitzart-snap"
    install -Dm644 "$SHARE/00-blitzart-snap-pre.hook"  "$MNT/etc/pacman.d/hooks/00-blitzart-snap-pre.hook"
    install -Dm644 "$SHARE/zz-blitzart-snap-post.hook" "$MNT/etc/pacman.d/hooks/zz-blitzart-snap-post.hook"

    msg "Installing GRUB"
    local g="$MNT/etc/default/grub"
    sed -i -E \
        -e 's|^GRUB_DISTRIBUTOR=.*|GRUB_DISTRIBUTOR="BlitzArt"|' \
        -e 's|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 quiet"|' \
        -e 's|^#?GRUB_DISABLE_OS_PROBER=.*|GRUB_DISABLE_OS_PROBER=false|' "$g"
    grub_set() { # key value - replace (also if commented out) or append
        if grep -qE "^#?$1=" "$g"; then sed -i -E "s|^#?$1=.*|$1=$2|" "$g"; else echo "$1=$2" >>"$g"; fi
    }
    grub_set GRUB_TIMEOUT -1          # menu stays until a choice is made
    grub_set GRUB_TIMEOUT_STYLE menu  # always show the menu
    grep -q '^GRUB_DISTRIBUTOR=' "$g" || echo 'GRUB_DISTRIBUTOR="BlitzArt"' >>"$g"
    grep -q '^GRUB_DISABLE_OS_PROBER=' "$g" || echo 'GRUB_DISABLE_OS_PROBER=false' >>"$g"

    ach mkinitcpio -P >/dev/null 2>&1 || warn "mkinitcpio -P reported problems"
    ach grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=BlitzArt --recheck \
        || { warn "NVRAM entry failed, installing to the removable path"; \
             ach grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --recheck || die "grub-install failed"; }

    msg "Creating baseline snapshot"
    ach snapper --no-dbus -c root create -t single -u important=yes -d "BlitzArt fresh install" \
        || warn "could not create the baseline snapshot"

    ach grub-mkconfig -o /boot/grub/grub.cfg || die "grub-mkconfig failed"
}

do_install() {
    phase_disk
    phase_base
    phase_configure
    phase_repos
    phase_gui          # offline repo
    phase_ii_offline   # offline repo
    phase_upgrade      # full upgrade, only now
    phase_gui_net
    phase_ii
    phase_boot
    sync
    msg "Installation finished"
}

# ---------------------------------------------------------------- main
case "${1:-}" in
    -h|--help) echo "Usage: blitzinstall   (interactive installer for BlitzArt Linux)"; exit 0 ;;
    -V|--version) echo "blitzinstall $VERSION"; exit 0 ;;
esac

preflight
# live ISO only: show who the live users are and the password
[[ -f /etc/blitzart-live ]] && DLG --title "Live session" --msgbox "$(</etc/blitzart-live)" 14 66
ensure_net
main_menu
clear
mkdir -p "$(dirname "$LOG")"
set -o pipefail
do_install 2>&1 | tee -a "$LOG"
rc=${PIPESTATUS[0]}
if ((rc != 0)); then
    echo; warn "Installation FAILED (log: $LOG). The target is still mounted at $MNT."
    exit "$rc"
fi
umount -R "$MNT" 2>/dev/null || true
if yesno "BlitzArt is installed.\nReboot now? (remove the installation medium)" "Done"; then
    clear; reboot
fi
clear
